    def resetPassword(self):
        """Reset user password with beautiful dialog"""
        try:
            dialog = ResetPasswordDialog(self)
            if dialog.exec_() == QDialog.Accepted:
                current_password, new_password = dialog.getPasswords()
                
                # Verify current password
                conn = sqlite3.connect("testing_system.db")
                cursor = conn.cursor()
                
                cursor.execute("SELECT password FROM users WHERE user_id = ?", (self.user_info['user_id'],))
                result = cursor.fetchone()
                
                if not result or str(result[0]) != current_password:
                    self.showStyledMessageBox("❌ Error", "Current password is incorrect!", "error")
                    conn.close()
                    return
                
                # Update password
                cursor.execute("UPDATE users SET password = ? WHERE user_id = ?", 
                             (int(new_password), self.user_info['user_id']))
                conn.commit()
                conn.close()
                
                self.showStyledMessageBox("✅ Success", "Password reset successfully!", "success")
                
        except Exception as e:
            self.showStyledMessageBox("❌ Error", f"Error resetting password: {str(e)}", "error")
    
