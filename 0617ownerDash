    def loadProfileData(self):
        """Load user profile data from database"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            # Get complete user profile with branch name
            cursor.execute("""
                SELECT u.fullname, u.username, u.password, r.role_name, 
                       COALESCE(b.branch_name, 'No Branch') as branch_name, 
                       u.email, u.phone_no
                FROM users u
