    def get_batch_number(self, product_name):
        """Generate batch number in format 'ByyyymmddA'"""
        current_date = datetime.now()
        date_part = current_date.strftime("%Y%m%d")
        base_batch = f"B{date_part}"
        
        conn = sqlite3.connect('testing_system.db')
        cursor = conn.cursor()
        
        # Get all batches for the current date to determine the next sequence letter
        cursor.execute("""
            SELECT batch FROM products 
            WHERE batch LIKE ? 
            ORDER BY batch DESC
        """, (f"{base_batch}%",))
        
        existing_batches = cursor.fetchall()
        conn.close()
        
        if not existing_batches:
            # First batch of the day
            return f"{base_batch}A"
        else:
            # Get the last sequence letter and increment
            last_batch = existing_batches[0][0]
            if len(last_batch) > len(base_batch):
                last_letter = last_batch[-1]
                # Increment the letter (A->B, B->C, etc.)
                next_letter = chr(ord(last_letter) + 1)
                return f"{base_batch}{next_letter}"
            else:
                return f"{base_batch}A"
    
