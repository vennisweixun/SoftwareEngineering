        """)
        close_btn.clicked.connect(self.accept)
        
        button_layout.addStretch()
        button_layout.addWidget(close_btn)
        button_layout.addStretch()
        
        layout.addLayout(button_layout)
        self.setLayout(layout)
    
    def create_info_field(self, label_text, value_text):
        """Create a styled info field"""
        container = QFrame()
        container.setStyleSheet("QFrame { background-color: white; border-radius: 5px; padding: 10px; }")
        
        layout = QVBoxLayout()
        layout.setSpacing(5)
        
        label = QLabel(label_text)
        label.setStyleSheet("font-size: 14px; font-weight: bold; color: #495057;")
        
        value = QLabel(value_text)
        value.setStyleSheet("font-size: 14px; color: #212529;")
        value.setWordWrap(True)
        
        layout.addWidget(label)
        layout.addWidget(value)
        
        container.setLayout(layout)
        container.value_label = value  # Store reference for updating
        
        return container
    
    def loadProductData(self):
        """Load product data from database"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            cursor.execute("""
                SELECT p.product_id, p.product_name, p.product_image, 
                       COALESCE(r.rack_location_name, 'No Location') as rack_location_name,
                       p.sku, p.manufacture_date, p.expired_date, p.barcode,
                       p.arrival_date, p.batch
                FROM products p
                LEFT JOIN racklocations r ON p.rack_location_id = r.rack_location_id
                WHERE p.product_id = ?
            """, (self.product_id,))
            
            product = cursor.fetchone()
            conn.close()
            
            if product:
                product_id, product_name, product_image, rack_location, sku, manufacture_date, expired_date, barcode, arrival_date, batch = product
                
                # Update fields
                self.product_name_label.value_label.setText(product_name or 'N/A')
                self.product_id_label.value_label.setText(str(product_id))
                self.barcode_label.value_label.setText(barcode or 'N/A')
                self.sku_label.value_label.setText(str(sku) if sku else 'N/A')
                self.batch_label.value_label.setText(batch or 'N/A')
                self.location_label.value_label.setText(rack_location)
                self.manufacture_date_label.value_label.setText(manufacture_date[:10] if manufacture_date else 'N/A')
                self.expiry_date_label.value_label.setText(expired_date[:10] if expired_date else 'N/A')
                self.arrival_date_label.value_label.setText(arrival_date[:10] if arrival_date else 'N/A')
                
                # Handle product image
                if product_image and product_image.strip():
                    try:
                        pixmap = QPixmap(product_image)
                        if not pixmap.isNull():
                            scaled_pixmap = pixmap.scaled(140, 140, Qt.KeepAspectRatio, Qt.SmoothTransformation)
                            self.image_label.setPixmap(scaled_pixmap)
                            self.image_label.setStyleSheet("QLabel { background-color: #e9ecef; border-radius: 8px; border: 1px solid #dee2e6; }")
                        else:
                            self.set_placeholder_image()
                    except:
                        self.set_placeholder_image()
                else:
                    self.set_placeholder_image()
            else:
                QMessageBox.warning(self, "Error", "Product not found!")
                self.reject()
                
        except sqlite3.Error as e:
            QMessageBox.warning(self, "Database Error", f"Error loading product: {str(e)}")
            self.reject()
    
    def set_placeholder_image(self):
        """Set placeholder image"""
        self.image_label.setText("📦\nNo Image")
        self.image_label.setStyleSheet("""
            QLabel { 
                background-color: #e9ecef; 
                border-radius: 8px; 
                border: 2px dashed #6c757d;
                font-size: 24px;
                color: #6c757d;
            }
        """)


