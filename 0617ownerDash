    def generate_barcode(self):
        """Generate a random barcode number"""
        import random
        return ''.join([str(random.randint(0, 9)) for _ in range(12)])
    
    def save_product_to_db(self, name, desc, m_date, e_date, a_date, sku, location_id, batch, barcode_number, image_path):
        """Save the product information to the database"""
        try:
            conn = sqlite3.connect('testing_system.db')
            cursor = conn.cursor()

            # Get the first available branch_id
            cursor.execute("SELECT branch_id FROM branches LIMIT 1")
            branch_result = cursor.fetchone()
            branch_id = branch_result[0] if branch_result else 1

            # Correct column mapping based on the updated products table schema
            cursor.execute('''
                INSERT INTO products (
                    owner_id, product_name, product_desc, product_image, batch, arrival_date, 
                    branch_id, batch, rack_location_id, sku, manufacture_date, 
                    expired_date
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                self.user_info['user_id'],  # owner_id (current user is the owner adding the product)
                name,                       # product_name
                desc,                       # product_desc (description field)
                image_path,                 # product_image
                batch,                      # batch
                a_date,                     # arrival_date
                branch_id,                  # branch_id
                batch,                      # batch
                location_id,                # rack_location_id
                int(sku),                   # sku (ensure it's integer)
                m_date,                     # manufacture_date
                e_date                    # expired_date
            ))
            conn.commit()
            conn.close()

            QMessageBox.information(
                self,
                "Request Submitted",
                "Your request to add the items already sent to admin. Please wait for approval, it will takes 1-3 working days."
            )
        except sqlite3.Error as e:
            QMessageBox.critical(
                self,
                "Database Error",
                f"Failed to save product: {str(e)}"
            )

