    def loadProductData(self):
        """Load products data from database and display as cards"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            # Get owner's products with rack location names
            cursor.execute("""
                SELECT p.product_id, p.product_name, p.product_image, 
                       COALESCE(r.rack_location_name, 'No Location') as rack_location_name,
                       p.sku, p.manufacture_date, p.expired_date, p.barcode
                FROM products p
                LEFT JOIN racklocations r ON p.rack_location_id = r.rack_location_id
                WHERE p.owner_id = ?
                ORDER BY p.product_name
            """, (self.user_info['user_id'],))
            
            self.all_products = cursor.fetchall()
            
            # No automatic sample data creation - load only real products
            
            conn.close()
            
            # Display all products initially
            self.displayProducts(self.all_products)
            
        except sqlite3.Error as e:
            QMessageBox.warning(self, "Database Error", f"Error loading products: {str(e)}")
    
    def displayProducts(self, products):
        """Display products as cards in grid layout"""
        # Clear existing cards
        for i in reversed(range(self.products_grid_layout.count())):
            child = self.products_grid_layout.itemAt(i).widget()
            if child:
                child.setParent(None)
        
        if not products:
            # Show enhanced empty state
            empty_container = QFrame()
            empty_container.setObjectName("emptyStateContainer")
            empty_layout = QVBoxLayout()
            empty_layout.setAlignment(Qt.AlignCenter)
            empty_layout.setSpacing(15)
            
            # Empty state icon
            empty_icon = QLabel("📦")
            empty_icon.setAlignment(Qt.AlignCenter)
            empty_icon.setStyleSheet("font-size: 64px; color: #90CAF9; margin: 20px;")
            
            # Empty state message
            empty_label = QLabel("No products found")
            empty_label.setObjectName("emptyStateLabel")
            empty_label.setAlignment(Qt.AlignCenter)
            
            # Empty state subtitle
            empty_subtitle = QLabel("Add your first product to get started!")
            empty_subtitle.setAlignment(Qt.AlignCenter)
            empty_subtitle.setStyleSheet("font-size: 14px; color: #999; margin-top: 5px;")
            
            empty_layout.addWidget(empty_icon)
            empty_layout.addWidget(empty_label)
            empty_layout.addWidget(empty_subtitle)
            empty_container.setLayout(empty_layout)
            
            self.products_grid_layout.addWidget(empty_container, 0, 0, 1, 3)
            return
        
        # Add product cards to grid (3 columns for better spacing with larger cards)
        row = 0
        col = 0
        for product in products:
            card = self.createProductCard(product)
            self.products_grid_layout.addWidget(card, row, col)
            
            col += 1
            if col >= 3:  # 3 cards per row for better layout with larger cards
                col = 0
                row += 1
    
    def filterProducts(self):
        """Filter products based on search input"""
        if not hasattr(self, 'all_products'):
            return
        
        search_text = self.search_input.text().strip().lower()
        
        if not search_text:
            # Show all products
            self.displayProducts(self.all_products)
            return
        
        # Filter products by name
        filtered_products = []
        for product in self.all_products:
            product_name = product[1] or ""  # product_name is at index 1
            if search_text in product_name.lower():
                filtered_products.append(product)
        
        # Display filtered products
        self.displayProducts(filtered_products)
    
    def performSearch(self):
        """Perform search when search button is clicked or Enter is pressed"""
        self.filterProducts()  # Use the existing filter method
        
        search_text = self.search_input.text().strip()
        if search_text:
            print(f"🔍 Searching for products containing: '{search_text}'")
        else:
            print("🔍 Showing all products")
    
