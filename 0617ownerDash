    def validateAndAccept(self):
        """Validate inputs and accept dialog"""
        current = self.current_password_input.text().strip()
        new = self.new_password_input.text().strip()
        confirm = self.confirm_password_input.text().strip()
        
        if not current:
            self.showError("Please enter your current password")
            self.current_password_input.setFocus()
            return
        
        if not new:
            self.showError("Please enter a new password")
            self.new_password_input.setFocus()
            return
        
        # Validate new password
        try:
            int(new)
            if len(new) < 4:
                self.showError("Password must be at least 4 digits long")
                self.new_password_input.setFocus()
                return
        except ValueError:
            self.showError("Password must contain only numbers")
            self.new_password_input.setFocus()
            return
        
        if new != confirm:
            self.showError("Passwords do not match")
            self.confirm_password_input.setFocus()
            return
        
        self.current_password = current
        self.new_password = new
        self.accept()
    
    def showError(self, message):
        """Show error message with styling"""
        msg = QMessageBox(self)
        msg.setIcon(QMessageBox.Warning)
        msg.setWindowTitle("❌ Validation Error")
        msg.setText(message)
        msg.setStyleSheet(f"""
            QMessageBox {{
                background-color: white;
                border: 2px solid {self.colors['error']};
                border-radius: 10px;
                font-family: 'Segoe UI', Arial, sans-serif;
                font-size: 14px;
                min-width: 350px;
            }}
            QMessageBox QLabel {{
                font-size: 14px;
                padding: 15px;
                color: #333;
            }}
            QMessageBox QPushButton {{
                background-color: {self.colors['error']};
                color: white;
                border: none;
                border-radius: 6px;
                padding: 12px 25px;
                font-weight: bold;
                font-size: 14px;
                min-width: 80px;
            }}
        """)
        msg.exec_()
    
    def getPasswords(self):
        """Return the validated passwords"""
        return self.current_password, self.new_password

