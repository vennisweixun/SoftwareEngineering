    def loadProductData(self):
        """Load existing product data for editing"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            cursor.execute("""
                SELECT product_name, batch, sku, manufacture_date, expired_date 
                FROM products 
                WHERE product_id = ?
            """, (self.product_id,))
            
            product = cursor.fetchone()
            if product:
                self.product_name.setText(product[0] or "")
                self.batch.setText(product[1] or "")
                self.sku.setValue(product[2] or 1)
                if product[3]:
                    self.manufacture_date.setDate(QDate.fromString(product[3][:10], "yyyy-MM-dd"))
                if product[4]:
                    self.expiry_date.setDate(QDate.fromString(product[4][:10], "yyyy-MM-dd"))
            
            conn.close()
            
        except sqlite3.Error as e:
            QMessageBox.warning(self, "Database Error", f"Error loading product: {str(e)}")
    
    def accept(self):
        """Save product data"""
        if not self.product_name.text().strip():
            QMessageBox.warning(self, "Validation Error", "Product name is required!")
            return
        
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            manufacture_date_str = self.manufacture_date.date().toString("yyyy-MM-dd")
            expiry_date_str = self.expiry_date.date().toString("yyyy-MM-dd")
            arrival_date_str = QDate.currentDate().toString("yyyy-MM-dd")
            
            if self.product_id:
                # Update existing product
                cursor.execute("""
                    UPDATE products 
                    SET product_name = ?, batch = ?, sku = ?, 
                        manufacture_date = ?, expired_date = ?
                    WHERE product_id = ?
                """, (
                    self.product_name.text(),
                    self.batch.text(),
                    self.sku.value(),
                    manufacture_date_str,
                    expiry_date_str,
                    self.product_id
                ))
            else:
                # Add new product
                cursor.execute("""
                    INSERT INTO products (owner_id, product_name, batch, sku, 
                                        manufacture_date, expired_date, arrival_date)
                    VALUES (?, ?, ?, ?, ?, ?, ?)
                """, (
                    self.parent.user_info['user_id'],
                    self.product_name.text(),
                    self.batch.text(),
                    self.sku.value(),
                    manufacture_date_str,
                    expiry_date_str,
                    arrival_date_str
                ))
            
            conn.commit()
            conn.close()
            
            super().accept()
            
        except sqlite3.Error as e:
            QMessageBox.warning(self, "Database Error", f"Error saving product: {str(e)}")

