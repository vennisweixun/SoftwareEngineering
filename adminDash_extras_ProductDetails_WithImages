            margin: 0px;
        """
        value_style = """
            color: #333333;
            border: none;
            padding: 0px;
            margin: 0px;
        """

        def make_label(text, bold=False, is_value=False):
            label = QLabel(text)
            font = QFont("Arial", 13)
            if bold:
                font.setBold(True)
            label.setFont(font)
            label.setStyleSheet(value_style if is_value else label_style)

            if is_value:
                label.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
            else:
                label.setAlignment(Qt.AlignCenter)
