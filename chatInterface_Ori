        self.setupUI()

    def setupUI(self):
        layout = QVBoxLayout()

        # Title
        title = QLabel("Medical Testing System Chat")
        title.setAlignment(Qt.AlignCenter)
        title.setFont(QFont("Arial", 16, QFont.Bold))
        title.setStyleSheet("color: #2E7D32; margin: 10px;")
        layout.addWidget(title)

        # Form
        form_layout = QFormLayout()

        self.username_input = QLineEdit()
        self.username_input.setPlaceholderText("Enter username")
        form_layout.addRow("Username:", self.username_input)

        self.password_input = QLineEdit()
        self.password_input.setPlaceholderText("Enter password (numbers only)")
        self.password_input.returnPressed.connect(self.login)
        form_layout.addRow("Password:", self.password_input)

        layout.addLayout(form_layout)

        # Buttons
        button_layout = QHBoxLayout()
        login_btn = QPushButton("Login")
        login_btn.clicked.connect(self.login)
        cancel_btn = QPushButton("Cancel")
        cancel_btn.clicked.connect(self.reject)

        button_layout.addWidget(login_btn)
        button_layout.addWidget(cancel_btn)
        layout.addLayout(button_layout)

        # Info
        info_label = QLabel("Note: Password must be numeric (INTEGER type)\nCreate users through the application interface")
        info_label.setStyleSheet("color: #666; font-size: 10px; margin: 10px;")
        info_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(info_label)

        self.setLayout(layout)

    def login(self):
        username = self.username_input.text().strip()
        password_text = self.password_input.text().strip()

        if not username or not password_text:
            QMessageBox.warning(self, "Error", "Please enter both username and password")
            return

        # Validate password is numeric
        try:
            password = int(password_text)
        except ValueError:
            QMessageBox.warning(self, "Error", "Password must be numeric (INTEGER type)")
            return

        print(f"🔍 Chat Login attempt for user: {username}")

        # Connect to database and verify login
        try:
            conn = sqlite3.connect("testing_system.db", timeout=10.0)
            cursor = conn.cursor()

            user_info = verify_user_login(cursor, username, password)

            if user_info:
                # Add full_name for compatibility
                user_info['full_name'] = user_info.get('fullname', user_info.get('username', 'Unknown'))
                self.user_info = user_info

                print(f"✓ Chat login successful for user: {username}")
                print(f"  - Role: {user_info['role_name']}")
                print(f"  - Full Name: {user_info['full_name']}")
                print(f"🕘 Malaysia Time: {format_malaysia_time()}")

                # Create notification table and track login for red dot removal
                create_notification_table(cursor)

                # Log user activity
                log_user_activity(cursor, user_info['user_id'], username,
                                user_info['role_id'], user_info['role_name'],
                                "chat_login", f"User logged into chat system")
                conn.commit()
                conn.close()
                self.accept()
            else:
                print(f"✗ Chat login failed for user: {username} - Invalid credentials")
                conn.close()
                QMessageBox.warning(self, "Login Failed", "Invalid username or password")

        except sqlite3.Error as e:
            print(f"✗ Database error during chat login: {str(e)}")
            QMessageBox.critical(self, "Database Error", f"Database error: {str(e)}")
        except Exception as e:
            print(f"✗ Unexpected error during chat login: {str(e)}")
            QMessageBox.critical(self, "Error", f"An unexpected error occurred: {str(e)}")

class UserActivityDialog(QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("User Activity Log")
        self.setFixedSize(700, 500)
        self.setupUI()
        self.load_activity()

    def setupUI(self):
        layout = QVBoxLayout()

        self.activity_table = QTableWidget()
        self.activity_table.setColumnCount(5)
        self.activity_table.setHorizontalHeaderLabels(["Username", "Role", "Activity", "Description", "Timestamp"])
        self.activity_table.horizontalHeader().setStretchLastSection(True)
        layout.addWidget(self.activity_table)

        close_btn = QPushButton("Close")
        close_btn.clicked.connect(self.accept)
        layout.addWidget(close_btn)

        self.setLayout(layout)

    def load_activity(self):
        conn = sqlite3.connect("testing_system.db")
        cursor = conn.cursor()
        activities = get_user_activity(cursor, 100)
        conn.close()

        self.activity_table.setRowCount(len(activities))
        for row, activity in enumerate(activities):
            # Parse activity message to extract activity and description
            username, role, activity, description, timestamp = activity
            if activity.startswith("[ACTIVITY]"):
                parts = activity.split(":", 1)
                activity_type = parts[0].replace("[ACTIVITY]", "").strip()
                description = parts[1].strip() if len(parts) > 1 else ""

                items = [username, role, activity_type, description, timestamp]
            else:
                items = [username, role, activity, description, timestamp]

            for col, value in enumerate(items):
                item = QTableWidgetItem(str(value))
                self.activity_table.setItem(row, col, item)

