    def send_private_message_inline(self):
        """Send a private message from the inline area"""
        if not self.active_pm_user or not hasattr(self, 'pm_input'):
            return
        
        message_text = self.pm_input.toPlainText().strip()
        if not message_text:
            return
        
        try:
            conn = sqlite3.connect("testing_system.db", timeout=10.0)
            cursor = conn.cursor()
            
            # Create private_messages table if it doesn't exist
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS private_messages (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    sender_user_id INTEGER,
                    sender_username TEXT,
                    receiver_username TEXT,
                    sender_role TEXT,
                    message_text TEXT,
                    timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
                )
            """)
            
            # Insert private message
            cursor.execute("""
                INSERT INTO private_messages 
                (sender_user_id, sender_username, receiver_username, sender_role, message_text)
                VALUES (?, ?, ?, ?, ?)
            """, (
                self.user_info.get('user_id'),
                self.user_info.get('username'),
                self.active_pm_user,
                self.user_info.get('role_name'),
                message_text
            ))
            
            # Log activity
            log_user_activity(cursor, 
                            self.user_info.get('user_id'), 
                            self.user_info.get('username'),
                            self.user_info.get('role_id'), 
                            self.user_info.get('role_name'),
                            "private_message_sent", 
                            f"Sent private message to {self.active_pm_user}: {message_text[:30]}...")
            
            conn.commit()
            conn.close()
            
            print(f"💬 Inline private message sent to {self.active_pm_user}: {message_text[:30]}...")
            
            self.pm_input.clear()
            self.load_private_messages_inline()
            
        except Exception as e:
            print(f"Error sending inline private message: {e}")
            QMessageBox.critical(self, "Error", f"Failed to send private message: {str(e)}")
    
    def send_message(self):
        """Send a new message"""
        if not hasattr(self, 'message_input'):
            return
        
        message_text = self.message_input.text().strip()
        if not message_text:
            return
        
        # Check if user has permission to tag (admin or superadmin)
        role_name = self.user_info.get('role_name', 'user').lower()
        if role_name in ['admin', 'superadmin'] and '@' in message_text:
            # Validate tagged users before sending
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            valid_users, invalid_users = validate_tagged_users(cursor, message_text)
            
            if invalid_users:
                conn.close()
                invalid_list = ', '.join(invalid_users)
                reply = QMessageBox.question(
                    self, 
                    "Invalid Tagged Users", 
                    f"The following tagged users do not exist:\n@{invalid_list}\n\n"
                    f"Would you like to edit your message and select valid users?",
                    QMessageBox.Yes | QMessageBox.No
                )
                
                if reply == QMessageBox.Yes:
                    # Keep the message in input for editing
                    return
                else:
                    # Clear the message
                    self.message_input.clear()
                    return
            
            conn.close()
        
        conn = sqlite3.connect("testing_system.db")
        cursor = conn.cursor()
        
        user_id = self.user_info.get('user_id')
        role_id = self.user_info.get('role_id')
        username = self.user_info.get('username', 'Unknown')
        
        # Insert message
        insert_message(cursor, user_id, username, role_name, role_id, message_text)
        
        # Get the message ID of the just inserted message
        message_id = cursor.lastrowid
        
        # Create notifications for tagged users
        create_notification_for_tags(cursor, message_id, message_text, user_id)
        
        log_user_activity(cursor, user_id, username, role_id, role_name, 
                         "message_sent", f"Sent message: {message_text[:50]}...")
        
        print(f"💬 Message sent by {username} ({role_name}): {message_text[:30]}...")
        
        conn.commit()
        conn.close()
        
        self.message_input.clear()
        self.load_messages()
    
    def clear_all_chat(self):
        """Clear all chat messages (superadmin only)"""
        role_name = self.user_info.get('role_name', 'user')
        if role_name != 'superadmin':
            QMessageBox.warning(self, "Access Denied", "Only superadmin can clear all chat")
            return
        
        reply = QMessageBox.question(self, "Confirm Clear All", 
                                   "Are you sure you want to clear all chat messages?",
                                   QMessageBox.Yes | QMessageBox.No)
        
        if reply == QMessageBox.Yes:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            user_id = self.user_info.get('user_id')
            role_id = self.user_info.get('role_id')
            username = self.user_info.get('username', 'Unknown')
            
            clear_all_messages(cursor)
            log_user_activity(cursor, user_id, username, role_id, role_name, 
                             "clear_all_chat", "Cleared all chat messages")
            
            print(f"🗑️ All chat messages cleared by {username} (superadmin)")
            
            conn.commit()
            conn.close()
            
            self.load_messages()
            QMessageBox.information(self, "Success", "All chat messages have been cleared")
    
    def delete_selected_message(self):
        """Delete selected message (admin only)"""
        role_name = self.user_info.get('role_name', 'user')
        if role_name not in ['admin', 'superadmin']:
            QMessageBox.warning(self, "Access Denied", "Only admin can delete messages")
            return
        
        QMessageBox.information(self, "Feature", "Message deletion feature will be enhanced in future updates")
    
    def view_user_activity(self):
        """View user activity log (superadmin only)"""
        role_name = self.user_info.get('role_name', 'user')
        if role_name != 'superadmin':
            QMessageBox.warning(self, "Access Denied", "Only superadmin can view user activity")
            return
        
        dialog = UserActivityDialog()
        dialog.exec_()
    
    def manage_users(self):
        """Manage users (superadmin only)"""
        role_name = self.user_info.get('role_name', 'user')
        if role_name != 'superadmin':
            QMessageBox.warning(self, "Access Denied", "Only superadmin can manage users")
            return
        
        dialog = UserManagementDialog()
        dialog.exec_()
    
    def closeEvent(self, event):
        """Log user logout when closing"""
        conn = sqlite3.connect("testing_system.db")
        cursor = conn.cursor()
        
        user_id = self.user_info.get('user_id')
        role_id = self.user_info.get('role_id')
        username = self.user_info.get('username', 'Unknown')
        role_name = self.user_info.get('role_name', 'user')
        
        log_user_activity(cursor, user_id, username, role_id, role_name, 
                         "chat_logout", "User logged out of chat system")
        
        print(f"👋 {username} ({role_name}) logged out of chat system")
        
        conn.commit()
        conn.close()
        event.accept()

def main():
    app = QApplication(sys.argv)
    
    print("=" * 60)
    print("💬 MEDICAL TESTING SYSTEM - CHAT INTERFACE")
    print("=" * 60)
    
    # Check if database exists, if not run setup
    try:
        print("🔍 Checking database connection...")
        conn = sqlite3.connect("testing_system.db", timeout=5.0)
        cursor = conn.cursor()
        cursor.execute("SELECT COUNT(*) FROM users")
        user_count = cursor.fetchone()[0]
        cursor.execute("SELECT COUNT(*) FROM roles") 
        role_count = cursor.fetchone()[0]
        conn.close()
        
        print(f"✓ Database connection successful")
        print(f"✓ Found {user_count} users in system")
        print(f"✓ Found {role_count} roles configured") 
        print("✓ Chat system ready")
        print("-" * 60)
        
    except Exception as e:
        print(f"✗ Database error: {str(e)}")
        QMessageBox.critical(None, "Database Error", 
                           "Database not found or error occurred.\nPlease run 'python databaseSetup1.py' first to initialize the database.")
        sys.exit()
    
    # Show login dialog
    login_dialog = LoginDialog()
    if login_dialog.exec_() == QDialog.Accepted and login_dialog.user_info:
        # Create and show chat window
        chat_window = ChatWindow(login_dialog.user_info)
        chat_window.show()
        
        print("🚀 Chat interface launched successfully")
        print("=" * 60)
        
        sys.exit(app.exec_())
    else:
        print("❌ Login cancelled or failed")
        sys.exit()

