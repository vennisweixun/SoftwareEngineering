        self.pm_display.setMinimumHeight(120)  # Reduced height
        self.pm_display.setMaximumHeight(150)  # Smaller max height
        self.pm_display.setPlaceholderText("Private messages will appear here...")
        self.pm_display.setStyleSheet("""
            QTextEdit {
                background-color: rgba(255, 255, 255, 0.8);
                border: 2px solid #ddd;
                border-radius: 8px;
                padding: 8px;
            }
        """)
        layout.addWidget(self.pm_display)

        # Message input
        input_layout = QHBoxLayout()
        self.pm_input = QLineEdit()
        self.pm_input.setPlaceholderText("Type your private message...")
        self.pm_input.returnPressed.connect(self.send_private_message)

        send_btn = QPushButton("Send")
        send_btn.clicked.connect(self.send_private_message)
        send_btn.setStyleSheet(f"background-color: {sender_color}; color: white; padding: 8px 16px; border: none; border-radius: 4px;")

        input_layout.addWidget(self.pm_input)
        input_layout.addWidget(send_btn)
        layout.addLayout(input_layout)

        # Close button
        close_btn = QPushButton("Close")
        close_btn.clicked.connect(self.close_chat)
        close_btn.setStyleSheet("background-color: #666; color: white; padding: 8px 16px; border: none; border-radius: 4px;")
        layout.addWidget(close_btn)

        self.setLayout(layout)

    def load_private_messages(self):
        """Load private messages between sender and target"""
        try:
            conn = sqlite3.connect("testing_system.db", timeout=10.0)
            cursor = conn.cursor()

            sender_username = self.sender_info.get('username')

            # Get private messages between these two users
            cursor.execute("""
                SELECT sender_username, receiver_username, message_text, timestamp, sender_role
                FROM private_messages 
                WHERE (sender_username = ? AND receiver_username = ?) 
                   OR (sender_username = ? AND receiver_username = ?)
                ORDER BY timestamp ASC
            """, (sender_username, self.target_username, self.target_username, sender_username))

            messages = cursor.fetchall()
            conn.close()

            # Clear and rebuild display
            self.pm_display.clear()

            for message in messages:
                sender, receiver, text, timestamp, sender_role = message

                # Format timestamp to Malaysia time
                time_str = format_malaysia_time(timestamp)

                # Get role color
                role_color = self.role_colors.get(sender_role.lower(), '#666666')

                # Determine if this is from current user
                is_current_user = (sender == sender_username)
                align = "right" if is_current_user else "left"
                bg_alpha = "25" if is_current_user else "15"

                # Format message
                formatted_message = (
                    f"<div style='margin: 8px 0; padding: 10px; "
                    f"border: 2px solid {role_color}; background-color: {role_color}{bg_alpha}; "
                    f"border-radius: 8px; text-align: {align};'>"
                    f"<div style='color: {role_color}; font-weight: bold; font-size: 11px; margin-bottom: 6px;'>"
                    f"👤 {sender} → 👤 {receiver} <span style='float: right; color: #888; font-size: 10px;'>[{time_str}]</span>"
                    f"</div>"
                    f"<div style='color: #333; font-size: 14px; line-height: 1.4;'>{text}</div>"
                    f"</div>"
                )

                self.pm_display.append(formatted_message)

            # Scroll to bottom
            scrollbar = self.pm_display.verticalScrollBar()
            scrollbar.setValue(scrollbar.maximum())

        except Exception as e:
            print(f"Error loading private messages: {e}")

    def send_private_message(self):
        """Send a private message"""
        message_text = self.pm_input.text().strip()
        if not message_text:
            return

        try:
            conn = sqlite3.connect("testing_system.db", timeout=10.0)
            cursor = conn.cursor()

            # Create private_messages table if it doesn't exist
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS private_messages (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    sender_user_id INTEGER,
                    sender_username TEXT,
                    receiver_username TEXT,
                    sender_role TEXT,
                    message_text TEXT,
                    timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
                )
            """)

            # Insert private message
            cursor.execute("""
                INSERT INTO private_messages 
                (sender_user_id, sender_username, receiver_username, sender_role, message_text)
                VALUES (?, ?, ?, ?, ?)
            """, (
                self.sender_info.get('user_id'),
                self.sender_info.get('username'),
                self.target_username,
                self.sender_info.get('role_name'),
                message_text
            ))

            # Log activity
            log_user_activity(cursor,
                            self.sender_info.get('user_id'),
                            self.sender_info.get('username'),
                            self.sender_info.get('role_id'),
                            self.sender_info.get('role_name'),
                            "private_message_sent",
                            f"Sent private message to {self.target_username}: {message_text[:30]}...")

            conn.commit()
            conn.close()

            print(f"💬 Private message sent from {self.sender_info.get('username')} to {self.target_username}")

            self.pm_input.clear()
            self.load_private_messages()

        except Exception as e:
            print(f"Error sending private message: {e}")
            QMessageBox.critical(self, "Error", f"Failed to send private message: {str(e)}")

    def close_chat(self):
        """Close the private chat dialog"""
        if hasattr(self, 'refresh_timer'):
            self.refresh_timer.stop()
        self.accept()

class ChatWindow(QMainWindow):
    def __init__(self, user_info):
        super().__init__()
        self.user_info = user_info
        self.private_chat_windows = {}  # Store private chat windows
        self.unread_message_ids = []  # Track unread tagged messages
        self.login_count = 0  # Track login count

        # Define role colors and themes FIRST (before setupUI)
        self.role_colors = {
            'superadmin': '#FF9800',  # Orange - Highest authority
            'admin': '#4CAF50',       # Green - Administrative
            'owner': '#2196F3',       # Blue - Business owner
            'tester': '#E91E63'       # Pink - Testing/Quality
        }

        # Secondary colors for gradients and hover effects
        self.role_secondary_colors = {
            'superadmin': '#F57C00',  # Darker orange
            'admin': '#388E3C',       # Darker green
            'owner': '#1976D2',       # Darker blue
            'tester': '#C2185B'       # Darker pink
        }

        # Initialize notification system
        self.init_notifications()

        self.setupUI()
        self.load_messages()
        self.load_available_users()

        # Auto-refresh messages and users every 3 seconds
        self.refresh_timer = QTimer()
        self.refresh_timer.timeout.connect(self.refresh_all)
        self.refresh_timer.start(3000)

    def init_notifications(self):
        """Initialize notification system and create tables"""
        try:
            conn = sqlite3.connect("testing_system.db", timeout=10.0)
            cursor = conn.cursor()

            # Create notification table
            create_notification_table(cursor)

            # Get unread notifications for current user
            user_id = self.user_info.get('user_id')
            self.unread_message_ids = get_unread_notifications(cursor, user_id)

            # Track login count - mark as read on second login
            self.login_count += 1
            if self.login_count >= 2:
                mark_user_login(cursor, user_id)
                conn.commit()
                self.unread_message_ids = []  # Clear notifications

            conn.close()
            print(f"📬 Notification system initialized. Unread tagged messages: {len(self.unread_message_ids)}")
            print(f"🕘 Session started at: {self.login_time}")

        except Exception as e:
            print(f"Error initializing notifications: {e}")

