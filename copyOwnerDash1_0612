    def updateProfile(self):
        """Update user profile"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            cursor.execute("""
                UPDATE users 
                SET fullname = ?, email = ? 
                WHERE user_id = ?
            """, (
                self.profile_fullname.text(),
                self.profile_email.text(),
                self.user_info['user_id']
            ))
            
            conn.commit()
            conn.close()
            
            # Update user_info
            self.user_info['fullname'] = self.profile_fullname.text()
            self.user_info['email'] = self.profile_email.text()
            
            QMessageBox.information(self, "Success", "Profile updated successfully!")
            
        except sqlite3.Error as e:
            QMessageBox.warning(self, "Database Error", f"Error updating profile: {str(e)}")
    
