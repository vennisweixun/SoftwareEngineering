    def createMenuButton(self, text, page_index):
        btn = QPushButton(text)
        btn.setObjectName("menuButton")
        btn.setFixedHeight(50)
        btn.clicked.connect(lambda: self.switchPage(page_index))
        return btn
        
    def switchPage(self, page_index):
        # Update button states
        for i, btn in enumerate(self.menu_buttons):
            if i == page_index:
                btn.setObjectName("menuButtonActive")
            else:
                btn.setObjectName("menuButton")
            btn.setStyleSheet("")  # Refresh style
        
        # Switch page
        self.content_stack.setCurrentIndex(page_index)
        
        # Refresh data for specific pages
        if page_index == 0:  # My Product
            self.loadProductData()
        elif page_index == 1:  # My Application
            self.loadApplicationData()
        elif page_index == 3:  # My Profile
            self.loadProfileData()
    
