    def loadProductData(self):
        """Load products data from database"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            # Get owner's products based on user_id
            cursor.execute("""
                SELECT p.product_id, p.product_name, p.batch, p.sku, p.expired_date 
                FROM products p
                WHERE p.user_id = ?
                ORDER BY p.product_name
            """, (self.user_info['user_id'],))
            
            products = cursor.fetchall()
            
            self.products_table.setRowCount(len(products))
            
            for row, product in enumerate(products):
                for col, value in enumerate(product):
                    item = QTableWidgetItem(str(value) if value else "N/A")
                    self.products_table.setItem(row, col, item)
                
                # Add action buttons
                action_widget = QWidget()
                action_layout = QHBoxLayout()
                action_layout.setContentsMargins(5, 5, 5, 5)
                
                edit_btn = QPushButton("✏️ Edit")
                edit_btn.setObjectName("actionButton")
                edit_btn.clicked.connect(lambda checked, p_id=product[0]: self.editProduct(p_id))
                
                delete_btn = QPushButton("🗑️ Delete")
                delete_btn.setObjectName("deleteButton")
                delete_btn.clicked.connect(lambda checked, p_id=product[0]: self.deleteProduct(p_id))
                
                action_layout.addWidget(edit_btn)
                action_layout.addWidget(delete_btn)
                action_widget.setLayout(action_layout)
                
                self.products_table.setCellWidget(row, 5, action_widget)
            
            conn.close()
            
        except sqlite3.Error as e:
            QMessageBox.warning(self, "Database Error", f"Error loading products: {str(e)}")
    
    def loadApplicationData(self):
        """Load testing assignments data based on current filter"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            status_filter = self.status_filter.currentText().lower()
            
            # Map status filter to assignment status
            status_mapping = {
                'pending': 1,    # Assuming 1 = Pending
                'approved': 2,   # Assuming 2 = Approved/In Progress
                'rejected': 3    # Assuming 3 = Rejected/Completed
            }
            
            status_id = status_mapping.get(status_filter, 1)
            
            # Get owner's testing assignments
            cursor.execute("""
                SELECT t.test_id, p.product_name, p.sku, 
                       ass.status_name, t.test_start
                FROM testing t
                JOIN products p ON t.product_id = p.product_id
                JOIN assignment_status ass ON t.assignment_status_id = ass.status_id
                WHERE p.user_id = ? AND t.assignment_status_id = ?
                ORDER BY t.test_start DESC
            """, (self.user_info['user_id'], status_id))
            
            applications = cursor.fetchall()
            
            self.applications_table.setRowCount(len(applications))
            
            for row, application in enumerate(applications):
                for col, value in enumerate(application):
                    item = QTableWidgetItem(str(value) if value else "N/A")
                    self.applications_table.setItem(row, col, item)
                
                # Add action buttons
                action_widget = QWidget()
                action_layout = QHBoxLayout()
                action_layout.setContentsMargins(5, 5, 5, 5)
                
                view_btn = QPushButton("👁️ View")
                view_btn.setObjectName("actionButton")
                view_btn.clicked.connect(lambda checked, a_id=application[0]: self.viewApplication(a_id))
                
                action_layout.addWidget(view_btn)
                action_widget.setLayout(action_layout)
                
                self.applications_table.setCellWidget(row, 5, action_widget)
            
            conn.close()
            
        except sqlite3.Error as e:
            QMessageBox.warning(self, "Database Error", f"Error loading testing data: {str(e)}")
    
