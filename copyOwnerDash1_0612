                color: {self.colors['text_primary']};
                font-size: 14px;
                font-weight: bold;
                margin-bottom: 5px;
            }}
        """)

class ProductDialog(QDialog):
    def __init__(self, parent, title, product_id=None):
        super().__init__(parent)
        self.parent = parent
        self.product_id = product_id
        self.setWindowTitle(title)
        self.setFixedSize(400, 300)
        self.setModal(True)
        
        self.setupUI()
        
        if product_id:
            self.loadProductData()
    
    def setupUI(self):
        layout = QVBoxLayout()
        
        # Form
        form_layout = QFormLayout()
        
        self.product_name = QLineEdit()
        self.batch = QLineEdit()
        self.sku = QSpinBox()
        self.sku.setMaximum(999999)
        self.sku.setMinimum(1)
        self.manufacture_date = QDateEdit()
        self.manufacture_date.setDate(QDate.currentDate())
        self.manufacture_date.setCalendarPopup(True)
        self.expiry_date = QDateEdit()
        self.expiry_date.setDate(QDate.currentDate().addDays(30))
        self.expiry_date.setCalendarPopup(True)
        
        form_layout.addRow("Product Name:", self.product_name)
        form_layout.addRow("Batch:", self.batch)
        form_layout.addRow("SKU:", self.sku)
        form_layout.addRow("Manufacture Date:", self.manufacture_date)
        form_layout.addRow("Expiry Date:", self.expiry_date)
        
        layout.addLayout(form_layout)
        
        # Buttons
        button_box = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        button_box.accepted.connect(self.accept)
        button_box.rejected.connect(self.reject)
        
        layout.addWidget(button_box)
        
        self.setLayout(layout)
    
    def loadProductData(self):
        """Load existing product data for editing"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            cursor.execute("""
                SELECT product_name, batch, sku, manufacture_date, expired_date 
                FROM products 
                WHERE product_id = ?
            """, (self.product_id,))
            
            product = cursor.fetchone()
            if product:
                self.product_name.setText(product[0] or "")
                self.batch.setText(product[1] or "")
                self.sku.setValue(product[2] or 1)
                if product[3]:
                    self.manufacture_date.setDate(QDate.fromString(product[3][:10], "yyyy-MM-dd"))
                if product[4]:
                    self.expiry_date.setDate(QDate.fromString(product[4][:10], "yyyy-MM-dd"))
            
            conn.close()
            
        except sqlite3.Error as e:
            QMessageBox.warning(self, "Database Error", f"Error loading product: {str(e)}")
    
    def accept(self):
        """Save product data"""
        if not self.product_name.text().strip():
            QMessageBox.warning(self, "Validation Error", "Product name is required!")
            return
        
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            manufacture_date_str = self.manufacture_date.date().toString("yyyy-MM-dd")
            expiry_date_str = self.expiry_date.date().toString("yyyy-MM-dd")
            arrival_date_str = QDate.currentDate().toString("yyyy-MM-dd")
            
            if self.product_id:
                # Update existing product
                cursor.execute("""
                    UPDATE products 
                    SET product_name = ?, batch = ?, sku = ?, 
                        manufacture_date = ?, expired_date = ?
                    WHERE product_id = ?
                """, (
                    self.product_name.text(),
                    self.batch.text(),
                    self.sku.value(),
                    manufacture_date_str,
                    expiry_date_str,
                    self.product_id
                ))
            else:
                # Add new product
                cursor.execute("""
                    INSERT INTO products (user_id, product_name, batch, sku, 
                                        manufacture_date, expired_date, arrival_date)
                    VALUES (?, ?, ?, ?, ?, ?, ?)
                """, (
                    self.parent.user_info['user_id'],
                    self.product_name.text(),
                    self.batch.text(),
                    self.sku.value(),
                    manufacture_date_str,
                    expiry_date_str,
                    arrival_date_str
                ))
            
            conn.commit()
            conn.close()
            
            super().accept()
            
        except sqlite3.Error as e:
            QMessageBox.warning(self, "Database Error", f"Error saving product: {str(e)}")

