            QComboBox:hover {
                border-color: #F57C00;
            }
        """)
        layout.addWidget(self.reason_combo)

        # Buttons
        button_layout = QHBoxLayout()

        cancel_btn = QPushButton("Cancel")
        cancel_btn.setStyleSheet("""
            QPushButton {
                background-color: #757575;
