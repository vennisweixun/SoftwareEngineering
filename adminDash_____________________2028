        while cur.execute("SELECT 1 FROM users WHERE username=?", (username,)).fetchone():
            suffix += 1
            username = f"{base}{suffix}"
        return username

    def generate_password(self):
        return random.randint(100000, 999999)  # 6-digit passcode

