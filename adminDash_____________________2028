                    FROM products p
                    LEFT JOIN racklocations rl ON p.rack_location_id = rl.rack_location_id
                    ORDER BY p.product_id DESC
                """)
            else:
                cur.execute("""
                    SELECT p.product_id, p.product_name, p.product_image, p.sku, COALESCE(rl.rack_location_name,'Unassigned')
                    FROM products p
                    LEFT JOIN racklocations rl ON p.rack_location_id = rl.rack_location_id
                    WHERE p.owner_id = ?
                    ORDER BY p.product_id DESC
