        layout.addWidget(instruction_label)

        # Reason dropdown
        self.reason_combo = QComboBox()
        self.reason_combo.addItems([
            "Labeling errors",
            "Expired medication",
            "Contamination issues",
            "Defective product",
            "Others"
        ])
        self.reason_combo.setStyleSheet("""
            QComboBox {
                border: 2px solid #FF9800;
                border-radius: 5px;
                padding: 8px;
                font-size: 14px;
                background-color: white;
