    def _process_and_show_review(self, product_data):
        """Process product data, save to DB, and show review window."""
        absolute_barcode_path = None # Initialize to None

        try:
            # Generate barcode and image
            barcode_value = ''.join(random.choices(string.digits, k=12))
            product_data["barcode"] = barcode_value
            barcode_class = barcode.get_barcode_class('code128')
            code128 = barcode_class(barcode_value, writer=ImageWriter())
            os.makedirs("barcodes", exist_ok=True)
            barcode_path = f"barcodes/{product_data['sku']}_{barcode_value}.png"

            # --- Get barcode image data directly as bytes ---
            barcode_image_bytes = None
            try:
                # Use ImageWriter to render the barcode directly to bytes
                # Ensure the writer is set to output bytes (format='png')
                from io import BytesIO # Import BytesIO
                # Render the barcode to a Pillow Image object
                pil_image = code128.render(writer_options={'format': 'png'}) # Render to PIL Image
                # Save the Pillow Image to a bytes buffer
                buffer = BytesIO()
                pil_image.save(buffer, format='PNG') # Save PIL Image to buffer as PNG
                barcode_image_bytes = buffer.getvalue() # Get bytes from the buffer
                buffer.close() # Close the buffer

                print("Barcode image data rendered to bytes successfully.") # Debug print
                product_data["barcode_image_data"] = barcode_image_bytes # Store bytes for review window
                # We still need the path for the database, even if not used for display here
                absolute_barcode_path = os.path.abspath(barcode_path) # Keep the path calculation
                product_data["barcode_image"] = absolute_barcode_path # Store path for database
            except Exception as e:
                print(f"Failed to render barcode image to bytes: {e}") # Debug print
            # --- End of getting bytes ---

            # --- Remove barcode_image_data before saving to DB ---
            if "barcode_image_data" in product_data:
                # Keep barcode_image_data for the review window, but don't save it to DB
                pass # No action needed, it's handled in show_review_window
            # --- End of remove ---

            # Save product data to the database HERE
            conn = sqlite3.connect("medical_system.db")
            cursor = conn.cursor()

            cursor.execute("""
                           INSERT INTO Products (user_id, product_name, manufacture_date, expired_date, arrival_date,
                                                 location, batch, barcode, barcode_image, sku, product_image)
                           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                           """, (
                               int(product_data["owner_id"]),
                               product_data["product_name"],
                               product_data["manufacture_date"],
                               product_data["expiry_date"],
                               product_data["arrival_date"],
                               product_data["rack_location"],
                               product_data["batch"],
                               product_data["barcode"],
                               product_data["barcode_image"], # Still save the path to DB
                               product_data["sku"],
                               product_data["product_image"]
                           ))

            # Get the product_id of the newly inserted product
            product_id = cursor.lastrowid
            product_data["product_id"] = product_id # Add product_id to data

            conn.commit()
            conn.close()

            # Show review window with data that now includes product_id
            self.show_review_window(product_data, self.processing_dialog) # Pass processing_dialog

        except Exception as e:
            # Close processing dialog before showing error
            if hasattr(self, 'processing_dialog') and self.processing_dialog.isVisible():
                 self.processing_dialog.reject()

            QMessageBox.critical(
                self,
                "Database Error",
                f"Failed to process product information: {str(e)}"
            )
            # If saving fails, perhaps clean up the generated barcode file?
            if absolute_barcode_path and os.path.exists(absolute_barcode_path):
                 try:
                     os.remove(absolute_barcode_path)
                 except Exception as cleanup_e:
                     print(f"Failed to clean up barcode file: {cleanup_e}")

    def show_review_window(self, product_data, processing_dialog): # Accept processing_dialog
        # Create and show the review window
        review_window = ProductReviewWindow(product_data, self.window(), processing_dialog) # Pass processing_dialog
        review_window.exec_()  # Use exec_() to make it a modal dialog


