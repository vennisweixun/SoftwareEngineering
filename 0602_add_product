# --- Processing Dialog ---
class ProcessingDialog(QDialog):
    def __init__(self, message="Processing...", parent=None):
        super().__init__(parent)
        self.setWindowTitle("Processing")
        self.setFixedSize(250, 100)
        self.setStyleSheet("background-color: #fff0e6;") # Light peach background
        layout = QVBoxLayout()
        self.label = QLabel(message)
        self.label.setFont(QFont("Arial", 12))
        self.label.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.label)
        self.setLayout(layout)
        self.setWindowFlag(Qt.FramelessWindowHint) # Remove frame and title bar
        self.setWindowModality(Qt.ApplicationModal) # Make it modal
        self.center_on_parent() # Center on parent window if available

    def center_on_parent(self):
        if self.parent():
            parent_rect = self.parent().geometry()
            self_rect = self.geometry()
            new_x = parent_rect.x() + (parent_rect.width() - self_rect.width()) // 2
            new_y = parent_rect.y() + (parent_rect.height() - self_rect.height()) // 2
            self.move(new_x, new_y)


