    def save_to_database(self):
        """Create notification for admin and close the window"""
        try:
            # Connect to the database
            conn = sqlite3.connect("medical_system.db")
            cursor = conn.cursor()

            # Retrieve product_id from stored data
            product_id = self.product_data.get("product_id")
            if product_id is None:
                 QMessageBox.critical(self, "Error", "Product ID not found.")
                 conn.close()
                 return # Cannot create notification without product_id

            # Create notification for admin
            cursor.execute("""
                           CREATE TABLE IF NOT EXISTS Notifications
                           (
                               notification_id
                               INTEGER
                               PRIMARY
                               KEY
                               AUTOINCREMENT,
                               user_id
                               INTEGER,
                               product_id
                               INTEGER,
                               message
                               TEXT,
                               timestamp
                               TEXT,
                               is_read
                               INTEGER
                               DEFAULT
                               0,
                               FOREIGN
                               KEY
                           (
                               user_id
                           ) REFERENCES Users
                           (
                               user_id
                           ),
                               FOREIGN KEY
                           (
                               product_id
                           ) REFERENCES Products
                           (
                               product_id
                           )
                               )
                           """)

            # Insert notification
            current_time = time.strftime('%Y-%m-%d %H:%M:%S')
            notification_message = f"New product '{self.product_data.get('product_name', 'N/A')}' awaiting approval" # Use .get with default

            # Find admin users to notify
            cursor.execute("SELECT user_id FROM Users WHERE role = 'admin'")
            admin_ids = cursor.fetchall()

            # Create notification for each admin
            for admin_id in admin_ids:
                cursor.execute("""
                               INSERT INTO Notifications (user_id, product_id, message, timestamp)
                               VALUES (?, ?, ?, ?)
                               """, (admin_id[0], product_id, notification_message, current_time))

            # Commit changes and close connection
            conn.commit()
            conn.close()

            # Show success message for notification
            QMessageBox.information(
                self,
                "Submitted",
                "Product information submitted to admin for approval."
            )

            # Close the dialog
            self.accept()

        except Exception as e:
            # Show error message if database operation fails
            QMessageBox.critical(
                self,
                "Database Error",
                f"Failed to create admin notification: {str(e)}"
            )


