    def _create_labeled_widget(self, label_text, widget, is_large=False):
        """Helper function to create a consistent labeled widget group."""
        container_layout = QVBoxLayout()
        label = QLabel(label_text)
        
        if is_large:
            label.setStyleSheet("font-weight: bold; font-size: 18px; margin-bottom: 5px; color: #333;")
        else:
            label.setStyleSheet("font-weight: bold; font-size: 14px; margin-bottom: 5px; color: #333;")
        
        # Common widget styling
        base_style = "padding: 8px; border-radius: 5px; border: 1px solid #ccc;"
        
        if isinstance(widget, QLineEdit):
            if is_large:
                widget.setStyleSheet(f"{base_style} font-size: 16px;")
                widget.setFixedHeight(45)
            else:
                widget.setStyleSheet(f"{base_style} font-size: 13px;")
                widget.setFixedHeight(38)
        elif isinstance(widget, QTextEdit):
            if is_large:
                widget.setStyleSheet(f"{base_style} font-size: 16px;")
            else:
                widget.setStyleSheet(f"{base_style} font-size: 13px;")
        elif isinstance(widget, QDateEdit):
            if is_large:
                widget.setStyleSheet(f"{base_style} font-size: 16px;")
                widget.setFixedHeight(45)
            else:
                widget.setStyleSheet(f"{base_style} font-size: 13px;")
                widget.setFixedHeight(38)

        container_layout.addWidget(label)
        container_layout.addWidget(widget)
        container_layout.setSpacing(3) # Reduced spacing between label and widget
        return container_layout
    
    def _create_separator(self):
        separator = QFrame()
        separator.setFrameShape(QFrame.HLine)
        separator.setFrameShadow(QFrame.Sunken)
        separator.setStyleSheet("background-color: #e0e0e0; height: 1px;")
        return separator

    # Add new method to handle frame click
    def frame_click(self, event):
        self.upload_image()

    def upload_image(self):
        path, _ = QFileDialog.getOpenFileName(self, "Select Image", "", "Image Files (*.png *.jpg *.jpeg *.bmp)")
        if path:
            self.image_path = path
            filename = os.path.basename(path)
            
            # Update image name label and show the upload another button
            self.image_name_label.setText(filename)
            self.upload_another_btn.show()
            
            # Load and display the image preview
            pixmap = QPixmap(path)
            if not pixmap.isNull():
                # Scale the pixmap to fit the frame while preserving aspect ratio
                preview_size = self.image_preview_frame.size()
                scaled_pixmap = pixmap.scaled(
                    preview_size.width() - 20, 
                    preview_size.height() - 20, 
                    Qt.KeepAspectRatio, 
                    Qt.SmoothTransformation
                )
                
                # Display the scaled image
                self.image_preview.setPixmap(scaled_pixmap)
                self.image_preview.setAlignment(Qt.AlignCenter)
                self.image_preview.setStyleSheet("border: none; background-color: transparent;")
                
                # Update the frame's appearance
                self.image_preview_frame.setStyleSheet(
                    "border: 1px solid #4CC9F0; border-radius: 12px; background-color: white; padding: 8px;"
                )
            else:
                self.image_preview.setText("Failed to load image")
                self.image_preview.setStyleSheet(
                    "border: none; background-color: transparent; font-size: 16px; color: red;"
                )
        else:
            # If cancelled, don't change anything if there's already an image
            if not self.image_path:
                self.image_name_label.setText("Image Name")
                self.upload_another_btn.hide()
                self.image_preview.setText("Upload Image")
                self.image_preview.setStyleSheet(
                    "border: none; background-color: transparent; font-size: 16px; color: #333;"
                )
                self.image_preview.setPixmap(QPixmap())  # Clear any previous image
                self.image_preview_frame.setStyleSheet(
                    "border: 2px dashed #4CC9F0; border-radius: 12px; background-color: #f5f5fa;"
                )

    def generate_barcode(self):
        number = ''.join([str(random.randint(0, 9)) for _ in range(12)])
        ean = barcode.get('ean13', number, writer=ImageWriter())
        filename = f"barcode_{number}"
        path = ean.save(filename)
        return number, path

    def get_next_batch_number(self, product_name):
        conn = sqlite3.connect('medical_system.db')
        cursor = conn.cursor()
        cursor.execute("SELECT COUNT(*) FROM Products WHERE product_name = ?", (product_name,))
        count = cursor.fetchone()[0]
        conn.close()
        return f"Batch {count + 1}"

    def add_product(self):
        name = self.name_input.text().strip()
        desc = self.desc_input.toPlainText().strip()
        m_date = self.manufacture_input.date().toString("yyyy-MM-dd")
        e_date = self.expired_input.date().toString("yyyy-MM-dd")
        a_date = self.arrival_input.date().toString("yyyy-MM-dd")
        sku = self.sku_input.text().strip()
        location = self.location_input.text().strip()

        if not name:
            QMessageBox.warning(self, "Missing Data", "Product name is required.")
            return

        batch = self.get_next_batch_number(name)
        barcode_number, barcode_path = self.generate_barcode()

        conn = sqlite3.connect('medical_system.db')
        cursor = conn.cursor()
        cursor.execute('''
            INSERT INTO Products (
                user_id, product_name, product_desc, manufacture_date,
                expired_date, arrival_date, sku, location, batch, barcode, product_image
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ''', (
            1, name, desc, m_date, e_date, a_date, sku, location, batch, barcode_number, self.image_path
        ))
        conn.commit()
        conn.close()

        QMessageBox.information(
            self,
            "Product Added",
            f"✅ Product added successfully!\n\n🆔 Batch: {batch}\n🔖 Barcode: {barcode_number}\n🖼️ Image: {os.path.basename(self.image_path)}\n📁 Barcode Saved at:\n{barcode_path}"
        )
        self.clear_fields()

    def clear_fields(self):
        self.name_input.clear()
        self.desc_input.clear()
        self.sku_input.clear()
        self.location_input.clear()
        self.manufacture_input.setDate(QDate.currentDate())
        self.expired_input.setDate(QDate.currentDate())
        self.arrival_input.setDate(QDate.currentDate())
        self.image_path = ''
        self.image_name_label.setText("Image Name")
        self.upload_another_btn.hide()
        self.image_preview.setText("Upload Image")
        self.image_preview.setStyleSheet("border: none; background-color: transparent; font-size: 16px; color: #333;")
        self.image_preview.setPixmap(QPixmap())  # Clear any previous image

