    def update_test_status(self, product_combo, status_combo, result_text):
        """Update test status, result, and attach image path (no memo field)."""
        print("Database full path:", os.path.abspath('medical_system.db'))

        # Validation
        selected_product = product_combo.get()
        if not selected_product or selected_product == "No products assigned":
            messagebox.showerror("Error", "Please select a product")
            return

        test_status = status_combo.get()
        if not test_status:
            messagebox.showerror("Error", "Please select a test status")
            return

        try:
            product_id = selected_product.split(" - ")[0].strip()
        except IndexError:
            messagebox.showerror("Error", "Invalid product selection")
            return

        test_result = result_text.get("1.0", "end").strip()
        user_id = self.get_current_user_id()
        from datetime import datetime
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        # Save image path as string if it exists
        image_path = self.attached_file_path if hasattr(self, 'attached_file_path') else None

        try:
            with sqlite3.connect('medical_system.db', timeout=10.0) as conn:
                cursor = conn.cursor()

                # Check if test record exists
                cursor.execute("SELECT test_id FROM Testing WHERE user_id = ? AND product_id = ?",
                               (user_id, product_id))
                row = cursor.fetchone()

                if row:
                    print("Updating existing test record...")
                    cursor.execute("""
                        UPDATE Testing
                        SET test_status = ?, test_result = ?, test_end = ?, test_image = ?
                        WHERE test_id = ?
                    """, (test_status, test_result, now, image_path, row[0]))
                else:
                    print("Inserting new test record...")
                    cursor.execute("""
                        INSERT INTO Testing (user_id, product_id, test_start, test_status, test_result, test_image)
                        VALUES (?, ?, ?, ?, ?, ?)
                    """, (user_id, product_id, now, test_status, test_result, image_path))

                conn.commit()

                # Verify the update
                cursor.execute("SELECT * FROM Testing WHERE user_id = ? AND product_id = ?", (user_id, product_id))
                print("Current record:", cursor.fetchone())

                messagebox.showinfo("Success", "Test status updated successfully!")

                # Clear form
                product_combo.set("")
                status_combo.set("")
                result_text.delete("1.0", "end")
                self.attached_file_path = None

        except sqlite3.Error as e:
            print("Database error:", e)
            messagebox.showerror("Database Error", f"Failed to update test status: {e}")
        except Exception as e:
            print("Unexpected error:", e)
            messagebox.showerror("Error", f"An unexpected error occurred: {e}")


    def apply_date_filter(self):
        start_date = self.start_date_entry.get_date()
        end_date = self.end_date_entry.get_date()
        self.load_test_schedule(self.user_id, start_date, end_date)

    def load_test_schedule(self):
        # Get selected dates
        start_date = self.start_date_entry.get_date()
        end_date = self.end_date_entry.get_date()

        # Validate date range
        if start_date > end_date:
            messagebox.showerror("Date Error", "Start date must not be after end date.")
            return

        # Clear the treeview
        for row in self.tree.get_children():
            self.tree.delete(row)

        # Connect to the database
        conn = sqlite3.connect('medical_system.db')
        cursor = conn.cursor()

        # Fetch schedule based on selected date range
        cursor.execute("""
            SELECT 
                P.product_name, 
                T.test_status,
                T.test_start,
                T.test_end
            FROM Products P
            INNER JOIN product_tester_assignments A ON P.product_id = A.product_id
            LEFT JOIN Testing T ON T.product_id = P.product_id AND T.user_id = A.tester_id
            WHERE A.tester_id = ?
              AND (
                  date(T.test_start) BETWEEN ? AND ?
                  OR date(T.test_end) BETWEEN ? AND ?
              )
            ORDER BY P.product_name
        """, (self.user_id, start_date, end_date, start_date, end_date))

        rows = cursor.fetchall()
        conn.close()

        # Insert data into the treeview
        self.tree.tag_configure("overdue", background="lightcoral", foreground="white")
        for product_name, status, test_start, test_end in rows:
            overdue = False
            if status and status in ["Not Started", "In Progress"] and test_end:
                try:
                    end_dt = datetime.strptime(test_end, '%Y-%m-%d %H:%M:%S')
                    if end_dt.date() < datetime.today().date():
                        overdue = True
                except Exception:
                    pass

            tag = "overdue" if overdue else ""
            self.tree.insert('', 'end', values=(product_name, status, test_start, test_end), tags=(tag,))


    def export_history(self, tree, export_type):
        """Export test history to Excel or PDF"""
        try:
            data = []
            for item in tree.get_children():
                data.append(tree.item(item)['values'])

            if not data:
                messagebox.showwarning("No Data", "No test history to export")
                return

            columns = [tree.heading(col)['text'] for col in tree['columns']]
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            filename = f"test_history_{timestamp}"

            if export_type == "excel":
                filename += ".xlsx"
                self.export_to_excel(columns, data, filename)
            elif export_type == "pdf":
                filename += ".pdf"
                self.export_to_pdf(columns, data, filename)

            messagebox.showinfo("Export Successful", f"Exported to {filename}")

        except Exception as e:
            messagebox.showerror("Export Error", f"Failed to export: {str(e)}")

        if platform.system() == "Windows":
            os.startfile(filename)

    def export_to_excel(self, columns, data, filename):
        """Export data to Excel file"""
        df = pd.DataFrame(data, columns=columns)

        with pd.ExcelWriter(filename, engine='openpyxl') as writer:
            df.to_excel(writer, index=False, sheet_name='Sheet1')

            worksheet = writer.sheets['Sheet1']
            for i, col in enumerate(df.columns):
                col_width = max(df[col].astype(str).map(len).max(), len(col))
                worksheet.column_dimensions[get_column_letter(i + 1)].width = col_width + 2

    def export_to_pdf(self, columns, data, filename):
        """Export data to PDF file"""
        pdf = FPDF()
        pdf.add_page()

        # Font fallback if Arial is unavailable (e.g., Linux)
        if platform.system() == "Windows":
            pdf.set_font("Arial", size=10)
        else:
            pdf.set_font("Helvetica", size=10)

        pdf.cell(200, 10, txt="Test History Report", ln=1, align='C')
        pdf.cell(200, 10, txt=f"Generated on: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}", ln=1, align='C')

        col_widths = [40, 30, 30, 30, 60]

        # Header row
        for i, col in enumerate(columns):
            pdf.cell(col_widths[i], 10, txt=col, border=1)
        pdf.ln()

        # Content rows with multi-line support for longer text
        for row in data:
            max_lines = 1
            wrapped_row = []
            for i, item in enumerate(row):
                text = str(item)
                # Determine how many lines it will take
                lines = len(pdf.multi_cell(col_widths[i], 10, text, border=0, split_only=True))
                wrapped_row.append(text)
                max_lines = max(max_lines, lines)

            for line in range(max_lines):
                for i, text in enumerate(wrapped_row):
                    lines = pdf.multi_cell(col_widths[i], 10, text, border=0, split_only=True)
                    line_text = lines[line] if line < len(lines) else ""
                    pdf.cell(col_widths[i], 10, txt=line_text, border=1)
                pdf.ln()

        pdf.output(filename)


    def insert_expiry_reminders(self, user_id):
        today = date.today()
        upcoming = today + timedelta(days=2)

        try:
            conn = sqlite3.connect("medical_system.db")
            cursor = conn.cursor()

            cursor.execute("""
                SELECT ap.product_id, ap.expiry_date, p.product_name
                FROM AssignedProducts ap
                JOIN Products p ON ap.product_id = p.product_id
                WHERE ap.tester_id = ? AND DATE(ap.expiry_date) BETWEEN DATE(?) AND DATE(?)
            """, (user_id, today, upcoming))

            rows = cursor.fetchall()

            for product_id, expiry_date, product_name in rows:
                # Prevent duplicate reminders
                cursor.execute("""
                    SELECT 1 FROM Notifications
                    WHERE user_id = ? AND message LIKE ? AND DATE(timestamp) = DATE(?)
                """, (user_id, f"%{product_name}%expires%", today))
                exists = cursor.fetchone()

                if not exists:
                    message = f"Reminder: Product '{product_name}' (ID: {product_id}) expires on {expiry_date}. Please test it soon."
                    cursor.execute("""
                        INSERT INTO Notifications (user_id, message, timestamp, read)
                        VALUES (?, ?, ?, 0)
                    """, (user_id, message, datetime.now()))

            conn.commit()

        except sqlite3.Error as e:
            print("Reminder insertion failed:", e)

        finally:
            if conn:
                conn.close()


