    def _get_selected_product_id(self, tree):
        """Helper to get the product ID of the selected item in the treeview."""
        selected_item = tree.focus()
        if selected_item:
            return tree.item(selected_item, 'values')[0]  # Product ID is the first column
        return None

    def start_test(self, tree):
        """
        Starts a test for the selected product.
        If the test is already in progress or completed, shows a message.
        If paused or not started, updates the status to 'In Progress'.
        """
        product_id = self._get_selected_product_id(tree)
        if not product_id:
            self._show_message("Please select a product to start testing.", "Warning")
            return

        current_user_id = self.get_current_user_id()
        conn = None
        try:
            conn = sqlite3.connect('medical_system.db')
            cursor = conn.cursor()

            cursor.execute("SELECT test_status FROM Testing WHERE product_id = ? AND user_id = ?",
                           (product_id, current_user_id))
            existing_status = cursor.fetchone()

            if existing_status:
                status = existing_status[0].lower()

                if status == 'in progress':
                    self._show_message(f"Test for Product ID {product_id} is already In Progress.", "Info")
                    return
                elif status == 'completed':
                    self._show_message(f"Test for Product ID {product_id} is already Completed.", "Info")
                    return
                elif status == 'failed':
                    self._show_message(f"Test for Product ID {product_id} has already Failed.", "Info")
                    return
                elif status == 'paused' or status == 'not started' or status == 'retest required':
                    # Resume or start the test
                    cursor.execute("""
                        UPDATE Testing
                        SET test_status = 'In Progress', start_time = COALESCE(start_time, ?), end_time = NULL
                        WHERE product_id = ? AND user_id = ?
                    """, (datetime.now().strftime('%Y-%m-%d %H:%M:%S'), product_id, current_user_id))
                else:
                    self._show_message(f"Unrecognized test status: {status}", "Error")
                    return
            else:
                # No record found, insert a new one
                cursor.execute("""
                    INSERT INTO Testing (product_id, user_id, test_status, start_time)
                    VALUES (?, ?, 'In Progress', ?)
                """, (product_id, current_user_id, datetime.now().strftime('%Y-%m-%d %H:%M:%S')))

            conn.commit()
            self._show_message(f"Test for Product ID {product_id} started.", "Success")
            self.switch_frame("Product Assignments")  # Refresh the display

        except sqlite3.Error as e:
            print(f"Database Error (start_test): {e}")
            self._show_message(f"Database error: {e}", "Error")
        finally:
            if conn:
                conn.close()

    def pause_test(self, tree):
        """Pauses a test if it's currently in progress."""
        product_id = self._get_selected_product_id(tree)
        if not product_id:
            self._show_message("Please select a product to pause testing.", "Warning")
            return

        current_user_id = self.get_current_user_id()
        conn = None
        try:
            conn = sqlite3.connect('medical_system.db')
            cursor = conn.cursor()

            cursor.execute("SELECT test_status FROM Testing WHERE product_id = ? AND user_id = ?",
                           (product_id, current_user_id))
            existing_status = cursor.fetchone()

            if not existing_status:
                self._show_message(f"No test found for Product ID {product_id}.", "Info")
                return

            status = existing_status[0].lower()
            if status != 'in progress':
                self._show_message(f"Test for Product ID {product_id} is not In Progress.", "Info")
                return

            cursor.execute("""
                UPDATE Testing
                SET test_status = 'Paused'
                WHERE product_id = ? AND user_id = ?
            """, (product_id, current_user_id))

            conn.commit()
            self._show_message(f"Test for Product ID {product_id} has been paused.", "Success")
            self.switch_frame("Product Assignments")
        except sqlite3.Error as e:
            print(f"Database Error (pause_test): {e}")
            self._show_message(f"Database error: {e}", "Error")
        finally:
            if conn:
                conn.close()

    def end_test(self, tree):
        """Ends a test if it's not already completed or failed."""
        product_id = self._get_selected_product_id(tree)
        if not product_id:
            self._show_message("Please select a product to end testing.", "Warning")
            return

        current_user_id = self.get_current_user_id()
        conn = None
        try:
            conn = sqlite3.connect('medical_system.db')
            cursor = conn.cursor()

            cursor.execute("SELECT test_status FROM Testing WHERE product_id = ? AND user_id = ?",
                           (product_id, current_user_id))
            existing_status = cursor.fetchone()

            if not existing_status:
                self._show_message(f"No test found for Product ID {product_id}.", "Info")
                return

            status = existing_status[0].lower()
            if status in ['completed', 'failed']:
                self._show_message(f"Test for Product ID {product_id} is already {status.capitalize()}.", "Info")
                return

            cursor.execute("""
                UPDATE Testing
                SET test_status = 'Completed', end_time = ?
                WHERE product_id = ? AND user_id = ?
            """, (datetime.now().strftime('%Y-%m-%d %H:%M:%S'), product_id, current_user_id))

            conn.commit()
            self._show_message(f"Test for Product ID {product_id} has been completed.", "Success")
            self.switch_frame("Product Assignments")
        except sqlite3.Error as e:
            print(f"Database Error (end_test): {e}")
            self._show_message(f"Database error: {e}", "Error")
        finally:
            if conn:
                conn.close()

    def _show_message(self, message, title="Message"):
        """
        A simple message box replacement for alert/confirm.
        In a real application, you'd use a custom Tkinter Toplevel window.
        """
        msg_box = tk.Toplevel(self.root)
        msg_box.title(title)
        msg_box.geometry("300x100")
        msg_box.transient(self.root)  # Make it appear on top of the main window
        msg_box.grab_set()  # Disable interaction with the main window

        ttk.Label(msg_box, text=message, wraplength=280).pack(pady=10)
        ttk.Button(msg_box, text="OK", command=msg_box.destroy).pack(pady=5)

        self.root.wait_window(msg_box)  # Wait for the message box to close
