                background-color: #f44336;
                color: white;
                padding: 5px;
                border-radius: 5px;
                font-size: 13px;
            }
            QPushButton:hover {
                background-color: #da190b;
            }
        """)
        reject_btn.clicked.connect(lambda: self.reject_callback(self.product_id))

        action_layout.addWidget(approve_btn)
        action_layout.addWidget(reject_btn)

