            return

        if role == "product_owner" and not branch:
            QMessageBox.warning(self, "Input Error", "Please select a branch for the product owner.")
            return

        hashed_pw = hash_password(password)
        conn = sqlite3.connect("medical_system.db")
        c = conn.cursor()
        try:
            c.execute("INSERT INTO Users (username, password, role, branch) VALUES (?, ?, ?, ?)",
                      (username, hashed_pw, role, branch))
            conn.commit()
            QMessageBox.information(self, "Account Created", f"Account for {username} created successfully!")
            self.close()
        except sqlite3.IntegrityError:
            QMessageBox.critical(self, "Error", "Username already exists!")
        finally:
            conn.close()


