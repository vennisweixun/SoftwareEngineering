# === Database Setup ===
def init_db():
    conn = sqlite3.connect("medical_system.db")
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS Users (
        user_id INTEGER PRIMARY KEY AUTOINCREMENT,
        username TEXT UNIQUE NOT NULL,
        password TEXT NOT NULL,
        role TEXT CHECK(role IN ('admin', 'product_owner', 'tester')) NOT NULL,
        email TEXT,
        phone_no TEXT,
        branch TEXT CHECK(branch IN ('Golden Triangle', 'Raja Uda', 'Balik Pulau') OR branch IS NULL)
    )''')

    c.execute('''CREATE TABLE IF NOT EXISTS Products (
                                                         product_id INTEGER PRIMARY KEY AUTOINCREMENT,
                                                         user_id INTEGER,
                                                         product_name TEXT NOT NULL,
                                                         manufacture_date TEXT,
                                                         expired_date TEXT,
                                                         arrival_date TEXT,
                                                         location TEXT,
                                                         batch TEXT,
                                                         barcode TEXT,
                                                         barcode_image TEXT,
                                                         excel_name TEXT,
                                                         sku TEXT,
                                                         product_image TEXT,
                                                         description TEXT,
                                                         status TEXT DEFAULT 'pending' CHECK(status IN ('pending', 'approved', 'rejected')),
                                                         FOREIGN KEY (user_id) REFERENCES Users(user_id)
    )''')

    c.execute('''CREATE TABLE IF NOT EXISTS Notifications (
        notification_id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        message TEXT NOT NULL,
        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
        is_read INTEGER DEFAULT 0,
        product_id INTEGER,
        FOREIGN KEY (user_id) REFERENCES Users(user_id),
        FOREIGN KEY (product_id) REFERENCES Products(product_id)
    )''')

    try:
        c.execute("INSERT INTO Users (username, password, role, email, branch) VALUES (?, ?, ?, ?, ?)",
                  ("admin1", hash_password("admin123"), "admin", "admin1@example.com", "Golden Triangle"))
        c.execute("INSERT INTO Users (username, password, role, email, branch) VALUES (?, ?, ?, ?, ?)",
                  ("owner1", hash_password("owner123"), "product_owner", "owner1@example.com", "Raja Uda"))
        c.execute("INSERT INTO Users (username, password, role, email, branch) VALUES (?, ?, ?, ?, ?)",
                  ("tester1", hash_password("tester123"), "tester", "tester1@example.com", "Balik Pulau"))
    except sqlite3.IntegrityError:
        pass

    conn.commit()
    conn.close()


def alter_users_table():
    conn = sqlite3.connect("medical_system.db")
    c = conn.cursor()

    try:
        c.execute("ALTER TABLE Users ADD COLUMN email TEXT")
    except sqlite3.OperationalError:
        print("Column 'email' already exists.")

    try:
        c.execute("ALTER TABLE Users ADD COLUMN phone_no TEXT")
    except sqlite3.OperationalError:
        print("Column 'phone_no' already exists.")

    conn.commit()
    conn.close()


def alter_products_table():
    conn = sqlite3.connect("medical_system.db")
    c = conn.cursor()
    try:
        c.execute("ALTER TABLE Products ADD COLUMN status TEXT DEFAULT 'pending'")
    except sqlite3.OperationalError:
        print("Column 'status' already exists in Products table.")
    try:
        c.execute("ALTER TABLE Products ADD COLUMN description TEXT")
    except sqlite3.OperationalError:
        print("Column 'description' already exists in Products table.")
    conn.commit()
    conn.close()


# === Hash Password ===
def hash_password(password):
    return hashlib.sha256(password.encode()).hexdigest()


