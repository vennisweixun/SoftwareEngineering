        self.reject_callback = reject_callback
        self.initUI()

    def initUI(self):
        action_layout = QHBoxLayout(self)
        action_layout.setContentsMargins(0, 0, 0, 0)
        action_layout.setSpacing(5)
        action_layout.setSizeConstraint(QHBoxLayout.SetFixedSize)
        self.setMinimumSize(self.sizeHint()) # Set minimum size of the widget based on its sizeHint
        action_layout.activate() # Force layout recalculation

        approve_btn = QPushButton("Approve")
        approve_btn.setFixedSize(110, 25) # Fixed size for buttons
        approve_btn.setStyleSheet("""
            QPushButton {
                background-color: #4CAF50;
