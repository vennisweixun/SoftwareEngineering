        # Load products
        self.load_products()

    def load_products(self):
        try:
            conn = sqlite3.connect("medical_system.db")
            cursor = conn.cursor()
            
            # Get all pending products
            cursor.execute("""
                SELECT p.product_id, p.product_name, p.batch, p.sku, u.branch, 
                       p.manufacture_date, p.expired_date, p.status
                FROM Products p
                JOIN Users u ON p.user_id = u.user_id
                WHERE p.status = 'pending'
                ORDER BY p.product_id DESC
            """)
            
            products = cursor.fetchall()
            print(f"DEBUG: Loaded {len(products)} pending products.") # Debug print
            self.table.setRowCount(len(products))
            
            for row, product in enumerate(products):
                # Add product details
                self.table.setItem(row, 0, QTableWidgetItem(str(product[1])))  # Product Name
                self.table.setItem(row, 1, QTableWidgetItem(str(product[2])))  # Batch
                self.table.setItem(row, 2, QTableWidgetItem(str(product[3])))  # SKU
                self.table.setItem(row, 3, QTableWidgetItem(str(product[4])))  # Branch
                self.table.setItem(row, 4, QTableWidgetItem(str(product[5])))  # Manufacture Date
                self.table.setItem(row, 5, QTableWidgetItem(str(product[6])))  # Expiry Date
                
                # Create and set custom ProductActionWidget
                action_widget = ProductActionWidget(
                    product_id=product[0],
                    approve_callback=self.approve_product,
                    reject_callback=self.reject_product
                )
                self.table.setCellWidget(row, 6, action_widget)
            
            # Manually resize columns and rows to fit contents after populating
            self.table.resizeColumnsToContents()
            self.table.resizeRowsToContents()
            self.table.update() # Force repaint and layout update
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to load products: {str(e)}")
        finally:
            if 'conn' in locals():
                conn.close()

    def approve_product(self, product_id):
        conn = sqlite3.connect("medical_system.db")
        cursor = conn.cursor()
        
        try:
            # Update product status to approved
            cursor.execute("UPDATE Products SET status = 'approved' WHERE product_id = ?", (product_id,))
            conn.commit()
            
            # Get product owner's user_id
            cursor.execute("SELECT user_id FROM Products WHERE product_id = ?", (product_id,))
            user_id = cursor.fetchone()[0]
            
            # Add notification for product owner
            cursor.execute("""
                INSERT INTO Notifications (user_id, message, timestamp, is_read, product_id)
                VALUES (?, ?, datetime('now'), 0, ?)
            """, (user_id, "Your product has been approved!", product_id))
            conn.commit()
            
            QMessageBox.information(self, "Success", "Product has been approved!")
            self.load_products()  # Refresh the table
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to approve product: {str(e)}")
        finally:
            conn.close()

    def reject_product(self, product_id):
        conn = sqlite3.connect("medical_system.db")
        cursor = conn.cursor()
        
        try:
            # Update product status to rejected
            cursor.execute("UPDATE Products SET status = 'rejected' WHERE product_id = ?", (product_id,))
            conn.commit()
            
            # Get product owner's user_id
            cursor.execute("SELECT user_id FROM Products WHERE product_id = ?", (product_id,))
            user_id = cursor.fetchone()[0]
            
            # Add notification for product owner
            cursor.execute("""
                INSERT INTO Notifications (user_id, message, timestamp, is_read, product_id)
                VALUES (?, ?, datetime('now'), 0, ?)
            """, (user_id, "Your product has been rejected.", product_id))
            conn.commit()
            
            QMessageBox.information(self, "Success", "Product has been rejected!")
            self.load_products()  # Refresh the table
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to reject product: {str(e)}")
        finally:
            conn.close()

    def back_to_login(self):
        self.close()
        self.login = LoginWindow()
        self.login.show()

    def back_to_dashboard(self):
        self.close()
        self.parent.showFullScreen()


