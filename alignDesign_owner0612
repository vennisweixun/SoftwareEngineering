    def get_dashboard_stats(self):
        """Get dashboard statistics from database"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            # Total products by this owner
            cursor.execute("SELECT COUNT(*) FROM products WHERE user_id = ?", (self.user_id,))
            total_products = cursor.fetchone()[0]
            
            # For now, we'll use placeholder values since status isn't in the schema
            pending_products = max(0, total_products - 2)  # Assume most are pending
            approved_products = min(2, total_products)  # Assume few are approved
            
            # Products added this month
            from datetime import datetime, timedelta
            current_date = datetime.now()
            first_day_of_month = current_date.replace(day=1)
            cursor.execute("""
                SELECT COUNT(*) FROM products 
                WHERE user_id = ? AND arrival_date >= ?
            """, (self.user_id, first_day_of_month.strftime('%d/%m/%Y')))
            this_month = cursor.fetchone()[0]
            
            conn.close()
            
            return {
                'total_products': total_products,
                'pending_products': pending_products,
                'approved_products': approved_products,
                'this_month': this_month
            }
        except Exception as e:
            print(f"Error getting dashboard stats: {e}")
            return {
                'total_products': 0,
                'pending_products': 0,
                'approved_products': 0,
                'this_month': 0
            }

    def get_recent_products(self):
        """Get recent products from database"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            cursor.execute("""
                SELECT product_id, product_name, manufacture_date, expired_date, 
                       arrival_date, batch
                FROM products 
                WHERE user_id = ? 
                ORDER BY product_id DESC 
                LIMIT 5
            """, (self.user_id,))
            
            products = cursor.fetchall()
            conn.close()
            return products
        except Exception as e:
            print(f"Error getting recent products: {e}")
            return []

