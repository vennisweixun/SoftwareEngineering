            # For now, we'll use placeholder values since status isn't in the schema
            pending_products = max(0, total_products - 2)  # Assume most are pending
            approved_products = min(2, total_products)  # Assume few are approved
            
            # Products added this month
            from datetime import datetime, timedelta
            current_date = datetime.now()
            first_day_of_month = current_date.replace(day=1)
            cursor.execute("""
                SELECT COUNT(*) FROM products 
                WHERE user_id = ? AND arrival_date >= ?
            """, (self.user_id, first_day_of_month.strftime('%d/%m/%Y')))
            this_month = cursor.fetchone()[0]
            
            conn.close()
            
            return {
                'total_products': total_products,
                'pending_products': pending_products,
                'approved_products': approved_products,
                'this_month': this_month
            }
        except Exception as e:
