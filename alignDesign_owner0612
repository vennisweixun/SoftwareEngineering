            no_products_label.setFont(QFont("Arial", 16))
            no_products_label.setAlignment(Qt.AlignCenter)
            self.products_layout.addWidget(no_products_label)
        else:
            for product in products:
                product_data = {
                    "product_id": product[0],
                    "product_name": product[1],
                    "manufacture_date": product[2],
                    "expired_date": product[3],
                    "arrival_date": product[4],
                    "location": product[5],  # This is now rack_location_name
                    "batch": product[6],
                    "barcode": product[7],
                    "barcode_image": product[8],
                    "sku": product[9],
                    "product_image": product[10],
                    "status": product[11],
                    "description": product[12],
                    "branch": ""  # Will fetch below
                }
                # Fetch branch from users and branches tables for the product's owner
                conn_branch = sqlite3.connect("testing_system.db")
                cursor_branch = conn_branch.cursor()
                cursor_branch.execute("""
                    SELECT b.branch_name 
                    FROM users u 
                    LEFT JOIN branches b ON u.branch_id = b.branch_id 
                    WHERE u.user_id = (SELECT user_id FROM products WHERE product_id = ?)
                """, (product[0],))
                branch_result = cursor_branch.fetchone()
                conn_branch.close()
                if branch_result:
                    product_data["branch"] = branch_result[0] if branch_result[0] else ""

                card = ProductCardWidget(product_data)
                self.products_layout.addWidget(card)


