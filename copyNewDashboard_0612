    def load_summary_data(self):
        """Load summary data - no longer using summary cards"""
        conn = sqlite3.connect("testing_system.db")
        cursor = conn.cursor()
        
        # We'll store these counts for potential use elsewhere
        # Total samples
        cursor.execute("SELECT COUNT(*) FROM samples")
        self.total_samples = cursor.fetchone()[0]
        
        # Near maturation (within 60 days)
        cursor.execute("""
            SELECT COUNT(*) FROM samples 
            WHERE maturation_date BETWEEN DATE('now') AND DATE('now', '+60 days')
        """)
        self.near_maturation = cursor.fetchone()[0]
        
        # Expired samples
        cursor.execute("SELECT COUNT(*) FROM samples WHERE maturation_date < DATE('now')")
        self.expired_samples = cursor.fetchone()[0]
        
