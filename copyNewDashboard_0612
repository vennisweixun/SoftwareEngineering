            progress.setWindowTitle("📤 Exporting Report")
            progress.setWindowModality(Qt.WindowModal)
            progress.setStyleSheet("""
                QProgressDialog {
                    background-color: white;
                    border: 2px solid #9C27B0;
                    border-radius: 8px;
                }
                QProgressBar {
                    border: 2px solid #E1BEE7;
                    border-radius: 8px;
                    text-align: center;
                    background-color: #F3E5F5;
