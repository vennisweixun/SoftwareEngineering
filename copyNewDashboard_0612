        conn.close()
    
    def load_maturation_data(self):
        """Load upcoming maturation data"""
        conn = sqlite3.connect("testing_system.db")
        cursor = conn.cursor()
        
        cursor.execute("""
            SELECT product_name, batch_number, owner, tester, maturation_date,
                   CAST(julianday(maturation_date) - julianday('now') AS INTEGER) as days_left
            FROM samples 
            WHERE maturation_date BETWEEN DATE('now') AND DATE('now', '+60 days')
            ORDER BY maturation_date ASC
        """)
        
        data = cursor.fetchall()
        self.maturation_table.setRowCount(len(data))
        
        for row, sample in enumerate(data):
            for col, value in enumerate(sample):
                if col == 4:  # Maturation date
                    value = datetime.strptime(value, '%Y-%m-%d').strftime('%Y-%m-%d')
                elif col == 5:  # Days left
                    if value < 0:
                        value = f"EXPIRED ({abs(value)} days ago)"
                    else:
                        value = f"{value} days"
                
                item = QTableWidgetItem(str(value) if value else "")
                self.maturation_table.setItem(row, col, item)
        
        conn.close()
    
    def load_inventory_data(self, page=1, items_per_page=20):
        """Load inventory data with pagination"""
        conn = sqlite3.connect("testing_system.db")
        cursor = conn.cursor()
        
        offset = (page - 1) * items_per_page
        
        # Apply filters if any
        query = "SELECT * FROM samples"
        params = []
        conditions = []
        
        if hasattr(self, 'product_filter') and self.product_filter.text():
            conditions.append("product_name LIKE ?")
            params.append(f"%{self.product_filter.text()}%")
        
        if hasattr(self, 'batch_filter') and self.batch_filter.text():
            conditions.append("batch_number LIKE ?")
            params.append(f"%{self.batch_filter.text()}%")
        
        if hasattr(self, 'status_filter') and self.status_filter.currentText() != "All Status":
            conditions.append("status = ?")
            params.append(self.status_filter.currentText())
        
        if conditions:
            query += " WHERE " + " AND ".join(conditions)
        
        query += f" LIMIT {items_per_page} OFFSET {offset}"
        
        cursor.execute(query, params)
        data = cursor.fetchall()
        
        self.inventory_table.setRowCount(len(data))
        
        for row, sample in enumerate(data):
            for col, value in enumerate(sample):
                item = QTableWidgetItem(str(value) if value else "")
                self.inventory_table.setItem(row, col, item)
        
        # Update pagination info
        cursor.execute("SELECT COUNT(*) FROM samples")
        total_items = cursor.fetchone()[0]
        total_pages = (total_items + items_per_page - 1) // items_per_page
        self.page_label.setText(f"Page {page} of {total_pages}")
        
        conn.close()
    
