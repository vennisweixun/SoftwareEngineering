    def update_test_status(self):
        """Update test status, result, and image"""
        if not hasattr(self, 'product_combo') or self.product_combo.currentData() is None:
            QMessageBox.warning(self, "Error", "Please select a product")
            return
        
        product_id = self.product_combo.currentData()
        test_status = self.status_combo.currentText()
        test_result = self.result_text.toPlainText().strip()
        
        try:
            conn = sqlite3.connect('testing_system.db')
            cursor = conn.cursor()
            
            # Check if test record exists
            cursor.execute("SELECT test_id FROM Testing WHERE user_id = ? AND product_id = ?",
                          (self.user_id, product_id))
            existing = cursor.fetchone()
            
            current_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            
            if existing:
                cursor.execute("""
                    UPDATE Testing
                    SET test_status = ?, test_result = ?, test_end = ?, test_image = ?
                    WHERE test_id = ?
                """, (test_status, test_result, current_time, self.attached_file_path, existing[0]))
            else:
                cursor.execute("""
                    INSERT INTO Testing (user_id, product_id, test_start, test_status, test_result, test_image)
                    VALUES (?, ?, ?, ?, ?, ?)
                """, (self.user_id, product_id, current_time, test_status, test_result, self.attached_file_path))
            
            conn.commit()
            QMessageBox.information(self, "Success", "Test status updated successfully!")
            
            # Clear form
            self.status_combo.setCurrentIndex(0)
            self.result_text.clear()
            self.attached_file_path = None
            self.image_path_label.setText("No image selected")
            
        except sqlite3.Error as e:
            QMessageBox.critical(self, "Database Error", f"Failed to update test status: {e}")
        finally:
            if conn:
                conn.close()

    def load_test_schedule(self):
        """Load test schedule for the selected date range"""
        if not hasattr(self, 'schedule_table'):
            return
        
        start_date = self.start_date.date().toPyDate()
        end_date = self.end_date.date().toPyDate()
        
        try:
            conn = sqlite3.connect('testing_system.db')
            cursor = conn.cursor()
            
            cursor.execute("""
                SELECT s.product_name, t.test_status, t.test_start, t.test_end
                FROM Testing t
                INNER JOIN samples s ON t.product_id = s.id
                WHERE t.user_id = ? AND (
                    DATE(t.test_start) BETWEEN ? AND ? OR
                    DATE(t.test_end) BETWEEN ? AND ?
                )
                ORDER BY t.test_start
            """, (self.user_id, start_date, end_date, start_date, end_date))
            
            schedule_data = cursor.fetchall()
            
            self.schedule_table.setRowCount(len(schedule_data))
            for row_idx, row_data in enumerate(schedule_data):
                for col_idx, value in enumerate(row_data):
                    item = QTableWidgetItem(str(value) if value else "N/A")
                    self.schedule_table.setItem(row_idx, col_idx, item)
                    
        except sqlite3.Error as e:
            QMessageBox.critical(self, "Database Error", f"Error loading schedule: {e}")
        finally:
            if conn:
                conn.close()

    def export_history(self, export_type):
        """Export test history to Excel or PDF"""
        if not hasattr(self, 'history_table') or self.history_table.rowCount() == 0:
            QMessageBox.warning(self, "No Data", "No test history to export")
            return
        
        try:
            # Collect data from table
            data = []
            headers = []
            for col in range(self.history_table.columnCount()):
                headers.append(self.history_table.horizontalHeaderItem(col).text())
            
            for row in range(self.history_table.rowCount()):
                row_data = []
                for col in range(self.history_table.columnCount()):
                    item = self.history_table.item(row, col)
                    row_data.append(item.text() if item else "")
                data.append(row_data)
            
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            
            if export_type == "excel":
                filename = f"test_history_{timestamp}.xlsx"
                df = pd.DataFrame(data, columns=headers)
                df.to_excel(filename, index=False)
            elif export_type == "pdf":
                filename = f"test_history_{timestamp}.pdf"
                self.export_to_pdf(headers, data, filename)
            
            QMessageBox.information(self, "Export Successful", f"Data exported to {filename}")
            
        except Exception as e:
            QMessageBox.critical(self, "Export Error", f"Failed to export: {str(e)}")

    def export_to_pdf(self, headers, data, filename):
        """Export data to PDF file"""
        pdf = FPDF()
        pdf.add_page()
        pdf.set_font("Arial", size=10)
        
        pdf.cell(200, 10, txt="Test History Report", ln=1, align='C')
        pdf.cell(200, 10, txt=f"Generated on: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}", ln=1, align='C')
        
        col_widths = [40, 30, 30, 30, 60]
        
        # Header row
        for i, header in enumerate(headers):
            pdf.cell(col_widths[i], 10, txt=header, border=1)
        pdf.ln()
        
        # Data rows
        for row in data:
            for i, item in enumerate(row):
                pdf.cell(col_widths[i], 10, txt=str(item)[:20], border=1)  # Truncate long text
            pdf.ln()
        
        pdf.output(filename)

