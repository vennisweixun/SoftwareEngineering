    def create_test_analysis_section(self, layout):
        """Create the test analysis section"""
        analysis_group = QGroupBox("Test Analysis")
        analysis_layout = QVBoxLayout()
        
        # Summary statistics
        summary_group = QGroupBox("Summary Statistics")
        summary_layout = QVBoxLayout()
        
        try:
            conn = sqlite3.connect('testing_system.db')
            cursor = conn.cursor()
            
            # Get test statistics
            cursor.execute("""
                SELECT test_status, COUNT(*) 
                FROM Testing 
                WHERE user_id = ? 
                GROUP BY test_status
            """, (self.user_id,))
            
            status_counts = dict(cursor.fetchall())
            total_tests = sum(status_counts.values())
            
            # Calculate average duration
            cursor.execute("""
                SELECT AVG(julianday(test_end) - julianday(test_start)) as avg_duration
                FROM Testing 
                WHERE user_id = ? AND test_end IS NOT NULL AND test_start IS NOT NULL
            """, (self.user_id,))
            
            avg_duration_result = cursor.fetchone()
            avg_duration = round(avg_duration_result[0], 2) if avg_duration_result[0] else 0
            
            # Create summary text
            summary_text = f"""
🧪 Total Tests: {total_tests}
✅ Completed: {status_counts.get('Completed', 0)}
⏳ In Progress: {status_counts.get('In Progress', 0)}
💤 Not Started: {status_counts.get('Not Started', 0)}
❌ Failed: {status_counts.get('Failed', 0)}
🔁 Retest Required: {status_counts.get('Retest Required', 0)}
⏱ Average Duration: {avg_duration} days
            """
            
            summary_label = QLabel(summary_text)
            summary_label.setStyleSheet("font-family: monospace; padding: 10px; background: #f9f9f9; border-radius: 5px;")
            summary_layout.addWidget(summary_label)
            
        except sqlite3.Error as e:
            error_label = QLabel(f"Error loading analysis data: {e}")
            error_label.setStyleSheet("color: red; padding: 10px;")
            summary_layout.addWidget(error_label)
        finally:
            if conn:
                conn.close()
        
        summary_group.setLayout(summary_layout)
        analysis_layout.addWidget(summary_group)
        
        analysis_group.setLayout(analysis_layout)
        layout.addWidget(analysis_group)

    def create_notifications_section(self, layout):
        """Create the notifications section"""
        notifications_group = QGroupBox("Notifications")
        notifications_layout = QVBoxLayout()
        
        # Notifications table
        self.notifications_table = QTableWidget()
        self.notifications_table.setColumnCount(3)
        self.notifications_table.setHorizontalHeaderLabels([
            "Message", "Timestamp", "Read"
        ])
        self.notifications_table.horizontalHeader().setStretchLastSection(True)
        
        # Load notifications
        try:
            conn = sqlite3.connect('testing_system.db')
            cursor = conn.cursor()
            
            cursor.execute("""
                SELECT message, timestamp, read FROM Notifications
                WHERE user_id = ?
                ORDER BY timestamp DESC
            """, (self.user_id,))
            
            notifications = cursor.fetchall()
            
            if notifications:
                self.notifications_table.setRowCount(len(notifications))
                for row_idx, (message, timestamp, read_status) in enumerate(notifications):
                    self.notifications_table.setItem(row_idx, 0, QTableWidgetItem(message))
                    self.notifications_table.setItem(row_idx, 1, QTableWidgetItem(timestamp))
                    self.notifications_table.setItem(row_idx, 2, QTableWidgetItem("Yes" if read_status else "No"))
                
                # Mark notifications as read
                cursor.execute("""
                    UPDATE Notifications SET read = 1
                    WHERE user_id = ? AND read = 0
                """, (self.user_id,))
                conn.commit()
            
        except sqlite3.Error as e:
            error_label = QLabel(f"Error loading notifications: {e}")
            error_label.setStyleSheet("color: red; padding: 10px;")
            notifications_layout.addWidget(error_label)
        finally:
            if conn:
                conn.close()
        
        notifications_layout.addWidget(self.notifications_table)
        notifications_group.setLayout(notifications_layout)
        layout.addWidget(notifications_group)

