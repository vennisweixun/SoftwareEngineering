    def start_test(self):
        """Start a test for the selected product"""
        product_id = self.get_selected_product_id()
        if not product_id:
            QMessageBox.warning(self, "No Selection", "Please select a product to start testing.")
            return
        
        try:
            conn = sqlite3.connect('testing_system.db')
            cursor = conn.cursor()
            
            # Check if test already exists
            cursor.execute("SELECT test_status FROM Testing WHERE product_id = ? AND user_id = ?", 
                          (product_id, self.user_id))
            existing = cursor.fetchone()
            
            if existing:
                if existing[0] in ['In Progress', 'Completed']:
                    QMessageBox.information(self, "Test Status", f"Test is already {existing[0]}")
                    return
                else:
                    # Update existing test
                    cursor.execute("""
                        UPDATE Testing SET test_status = 'In Progress', test_start = ?
                        WHERE product_id = ? AND user_id = ?
                    """, (datetime.now().strftime('%Y-%m-%d %H:%M:%S'), product_id, self.user_id))
            else:
                # Insert new test
                cursor.execute("""
                    INSERT INTO Testing (product_id, user_id, test_status, test_start)
                    VALUES (?, ?, 'In Progress', ?)
                """, (product_id, self.user_id, datetime.now().strftime('%Y-%m-%d %H:%M:%S')))
            
            conn.commit()
            QMessageBox.information(self, "Success", f"Test started for Product ID {product_id}")
            self.switch_frame("Product Assignments")  # Refresh
            
        except sqlite3.Error as e:
            QMessageBox.critical(self, "Database Error", f"Error starting test: {e}")
        finally:
            if conn:
                conn.close()

    def pause_test(self):
        """Pause a test for the selected product"""
        product_id = self.get_selected_product_id()
        if not product_id:
            QMessageBox.warning(self, "No Selection", "Please select a product to pause testing.")
            return
        
        try:
            conn = sqlite3.connect('testing_system.db')
            cursor = conn.cursor()
            
            cursor.execute("""
                UPDATE Testing SET test_status = 'Paused'
                WHERE product_id = ? AND user_id = ? AND test_status = 'In Progress'
            """, (product_id, self.user_id))
            
            if cursor.rowcount > 0:
                conn.commit()
                QMessageBox.information(self, "Success", f"Test paused for Product ID {product_id}")
                self.switch_frame("Product Assignments")  # Refresh
            else:
                QMessageBox.information(self, "No Change", "No active test found to pause.")
                
        except sqlite3.Error as e:
            QMessageBox.critical(self, "Database Error", f"Error pausing test: {e}")
        finally:
            if conn:
                conn.close()

    def end_test(self):
        """End a test for the selected product"""
        product_id = self.get_selected_product_id()
        if not product_id:
            QMessageBox.warning(self, "No Selection", "Please select a product to end testing.")
            return
        
        try:
            conn = sqlite3.connect('testing_system.db')
            cursor = conn.cursor()
            
            cursor.execute("""
                UPDATE Testing SET test_status = 'Completed', test_end = ?
                WHERE product_id = ? AND user_id = ?
            """, (datetime.now().strftime('%Y-%m-%d %H:%M:%S'), product_id, self.user_id))
            
            if cursor.rowcount > 0:
                conn.commit()
                QMessageBox.information(self, "Success", f"Test completed for Product ID {product_id}")
                self.switch_frame("Product Assignments")  # Refresh
            else:
                QMessageBox.information(self, "No Change", "No test found to complete.")
                
        except sqlite3.Error as e:
            QMessageBox.critical(self, "Database Error", f"Error ending test: {e}")
        finally:
            if conn:
