    def create_progress_tracker_section(self, layout):
        """Create the progress tracker section"""
        progress_group = QGroupBox("Progress Tracker")
        progress_layout = QVBoxLayout()
        
        # Create matplotlib figure
        figure = Figure(figsize=(10, 6))
        canvas = FigureCanvas(figure)
        
        # Get data from database
        try:
            conn = sqlite3.connect('testing_system.db')
            cursor = conn.cursor()
            
            cursor.execute("""
                SELECT test_status, COUNT(*) 
                FROM Testing 
                WHERE user_id = ? 
                GROUP BY test_status
            """, (self.user_id,))
            status_data = cursor.fetchall()
            
            if status_data:
                ax = figure.add_subplot(111)
                statuses, counts = zip(*status_data)
                
                color_map = {
                    "Completed": "green",
                    "In Progress": "blue",
                    "Failed": "red",
                    "Retest Required": "orange",
                    "Not Started": "gray"
                }
                bar_colors = [color_map.get(status, 'black') for status in statuses]
                ax.bar(statuses, counts, color=bar_colors)
                ax.set_title('Test Status Summary')
                ax.set_ylabel('Number of Tests')
                
                # Calculate progress percentage
                total = sum(counts)
                completed = sum(c for s, c in zip(statuses, counts) if s == "Completed")
                progress_percent = int((completed / total) * 100) if total > 0 else 0
                
                progress_label = QLabel(f"Overall Progress: {progress_percent}% ({completed}/{total} tests completed)")
                progress_label.setAlignment(Qt.AlignCenter)
                progress_label.setStyleSheet("font-size: 16px; font-weight: bold; color: #2E7D32; padding: 10px;")
                progress_layout.addWidget(progress_label)
            else:
                ax = figure.add_subplot(111)
                ax.text(0.5, 0.5, 'No test data available', ha='center', va='center', transform=ax.transAxes)
                ax.set_title('Test Status Summary')
                
        except sqlite3.Error as e:
            ax = figure.add_subplot(111)
            ax.text(0.5, 0.5, f'Database error: {e}', ha='center', va='center', transform=ax.transAxes)
        finally:
            if conn:
                conn.close()
        
        canvas.draw()
        progress_layout.addWidget(canvas)
        
        progress_group.setLayout(progress_layout)
        layout.addWidget(progress_group)

