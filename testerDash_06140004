    def switch_frame(self, section):
        # Clear current content
        while self.content_stack.count():
            child = self.content_stack.widget(0)
            self.content_stack.removeWidget(child)
            child.deleteLater()
        
        # Update button states
        for btn_name, btn in self.nav_buttons.items():
            btn.setChecked(btn_name == section)
        
        # Create new content based on section
        content_widget = self.create_content_widget(section)
        self.content_stack.addWidget(content_widget)

