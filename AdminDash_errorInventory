    def load_assign_data(self):
        """Load products for rack assignment"""
        try:
            conn = sqlite3.connect("testing_system.db")
            cursor = conn.cursor()
            
            cursor.execute("""
                SELECT p.product_name, p.batch, 
                       u.username as owner, 
                       CASE 
                           WHEN rl.rack_location_name IS NOT NULL THEN rl.rack_location_name
                           ELSE 'Unassigned'
                       END as current_location
                FROM products p
                LEFT JOIN users u ON p.user_id = u.user_id
                LEFT JOIN racklocations rl ON p.rack_location_id = rl.rack_location_id
                ORDER BY p.arrival_date DESC
            """)
            
            data = cursor.fetchall()
            self.assign_table.setRowCount(len(data))
            
            for row, product in enumerate(data):
                for col, value in enumerate(product):
                    item = QTableWidgetItem(str(value) if value else "")
                    self.assign_table.setItem(row, col, item)
                    
                # Add rack location dropdown in the last column
                location_combo = QComboBox()
                
                # Load available rack locations
                cursor.execute("""
                    SELECT rack_location_name 
                    FROM racklocations 
                    WHERE rack_location_id NOT IN (
                        SELECT rack_location_id FROM products 
                        WHERE rack_location_id IS NOT NULL
                    )
                    ORDER BY rack_location_name
                """)
                
                available_locations = [row[0] for row in cursor.fetchall()]
                location_combo.addItems(["Select Location..."] + available_locations)
                
                # Set current selection if assigned
                current_location = product[3]
                if current_location != 'Unassigned':
                    index = location_combo.findText(current_location)
                    if index >= 0:
                        location_combo.setCurrentIndex(index)
                
                location_combo.currentTextChanged.connect(
                    lambda text, p_name=product[0], p_batch=product[1]: 
                    self.update_rack_assignment(p_name, p_batch, text)
                )
                
                self.assign_table.setCellWidget(row, 4, location_combo)
            
            conn.close()
            print(f"✓ Loaded {len(data)} products for rack assignment")
            
        except Exception as e:
            print(f"✗ Error loading assign data: {e}")
            self.assign_table.setRowCount(0)
        
