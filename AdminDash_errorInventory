            cursor.execute("""
                SELECT COUNT(*) FROM products 
                            WHERE expired_date BETWEEN DATE('now') AND DATE('now', '+60 days')
            AND expired_date IS NOT NULL
            """)
            result = cursor.fetchone()
            self.near_maturation = result[0] if result else 0
            
