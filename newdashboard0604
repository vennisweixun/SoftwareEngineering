    def init_database(self):
        """Initialize the database with sample tables"""
        conn = sqlite3.connect("medical_system.db")
        cursor = conn.cursor()
        
        # Samples table
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS samples (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                product_name TEXT NOT NULL,
                batch_number TEXT NOT NULL,
                owner TEXT NOT NULL,
                tester TEXT,
                status TEXT DEFAULT 'Pending',
                maturation_date DATE,
                created_date DATE DEFAULT CURRENT_DATE,
                notes TEXT
            )
        """)
        
        # Activity log table
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS activity_log (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user TEXT NOT NULL,
                action TEXT NOT NULL,
                timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
                details TEXT
            )
        """)
        
        # Insert sample data if tables are empty
        cursor.execute("SELECT COUNT(*) FROM samples")
        if cursor.fetchone()[0] == 0:
            sample_data = [
                ("Product A", "BATCH001", "John Doe", "Jane Smith", "Testing", "2024-03-15", "2024-01-15"),
                ("Product B", "BATCH002", "Alice Johnson", "", "Pending", "2024-04-20", "2024-01-20"),
                ("Product C", "BATCH003", "Bob Wilson", "Mike Brown", "Approved", "2024-02-10", "2024-01-10"),
                ("Product D", "BATCH004", "Carol Davis", "Sarah Lee", "Expired", "2024-01-05", "2023-12-05"),
                ("Product E", "BATCH005", "David Miller", "", "Pending", "2024-05-30", "2024-02-01"),
            ]
            
            cursor.executemany("""
                INSERT INTO samples (product_name, batch_number, owner, tester, status, maturation_date, created_date)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            """, sample_data)
        
        conn.commit()
        conn.close()
    
